---
import "../styles/global.css";
import site from "../data/site.json";

type Locale = "es" | "en";
type NavItem = [label: string, href: string];
const {
  locale = "es",
  title = "Bernardin Máquinas Agrícolas",
  description,
  image = "/og-default.jpg",
  type = "website",
  noindex = false,
} = Astro.props as {
  locale?: Locale;
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
};
const currentLocale: Locale = locale;
const nav = site.nav[currentLocale] as NavItem[];
const home = currentLocale === "en" ? "/en/" : "/";
const path = Astro.url.pathname;
const translations: Record<string, string> = {
  "/": "/en/",
  "/empresa": "/en/empresa",
  "/productos": "/en/productos",
  "/noticias": "/en/noticias",
  "/contacto": "/en/contacto",
  "/en/": "/",
  "/en/empresa": "/empresa",
  "/en/productos": "/productos",
  "/en/noticias": "/noticias",
  "/en/contacto": "/contacto",
};
const langUrl =
  translations[path] ??
  (path.startsWith("/en/") ? path.replace(/^\/en/, "") || "/" : `/en${path}`);
const currentPath = path.replace(/\/$/, "") || "/";
const logoAlt =
  currentLocale === "es"
    ? "Bernardin Máquinas Agrícolas"
    : "Bernardin Agricultural Machinery";

/* ---------- SEO ---------- */
const defaultDescription =
  currentLocale === "es"
    ? "Bernardin: maquinaria agrícola y tecnología de precisión para el campo argentino. Representamos marcas internacionales con asesoramiento y servicio postventa."
    : "Bernardin: agricultural machinery and precision technology for Argentine farms. International brands with expert advice and after-sales service.";
const metaDescription = description ?? defaultDescription;

// Misma convención que el sitemap (build.format "directory"): URLs con "/" final
const withSlash = (p: string) =>
  /\.[a-z0-9]+$/i.test(p) || p.endsWith("/") ? p : `${p}/`;
const abs = (p: string) => new URL(p, Astro.site).href;

const canonical = abs(withSlash(path));
const esPath = currentLocale === "es" ? path : langUrl;
const enPath = currentLocale === "en" ? path : langUrl;
const esHref = abs(withSlash(esPath));
const enHref = abs(withSlash(enPath));
const ogImage = abs(image);
const ogLocale = currentLocale === "es" ? "es_AR" : "en_US";
const ogLocaleAlt = currentLocale === "es" ? "en_US" : "es_AR";
const siteName = "Bernardin Máquinas Agrícolas";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": abs("/#organization"),
      name: siteName,
      url: abs("/"),
      logo: abs(site.theme.logo),
      email: site.contact.email,
      address: site.contact.address,
      foundingDate: "1924",
    },
    {
      "@type": "WebSite",
      "@id": abs("/#website"),
      url: abs("/"),
      name: siteName,
      inLanguage: ["es-AR", "en"],
      publisher: { "@id": abs("/#organization") },
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta
      name="robots"
      content={noindex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large"}
    />
    <link rel="canonical" href={canonical} />

    <!-- Idiomas alternativos -->
    <link rel="alternate" hreflang="es-AR" href={esHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={esHref} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon e íconos -->
    <link
      rel="icon"
      href="/brands/Bernardin/Logo - Condor con fondo.png"
      sizes="48x48"
    />
    <link
      rel="icon"
      href="/brands/Bernardin/Logo - Condor con fondo.png"
      type="image/svg+xml"
    />
    <link
      rel="apple-touch-icon"
      href="/brands/Bernardin/Logo - Condor con fondo.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#257446" />

    <!-- Datos estructurados -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="logo" href={home} aria-label={`${logoAlt} home`}>
          <img src={site.theme.logo} alt={logoAlt} />
        </a>
        <nav
          class="navlinks"
          aria-label={currentLocale === "es"
            ? "Navegación principal"
            : "Main navigation"}
        >
          {
            nav.map(([label, href]: NavItem) => (
              <a
                href={href}
                aria-current={
                  currentPath === href.replace(/\/$/, "") ||
                  (currentPath === "/" && href === "/")
                    ? "page"
                    : undefined
                }
              >
                {label}
              </a>
            ))
          }
          <a
            class="language-toggle"
            href={langUrl}
            aria-label={locale === "es"
              ? "View site in English"
              : "Ver sitio en español"}
          >
            <span
              class:list={{ "language-option": true, active: locale === "es" }}
              >ES</span
            ><span class="language-divider" aria-hidden="true">|</span><span
              class:list={{ "language-option": true, active: locale === "en" }}
              >EN</span
            >
          </a>
        </nav>
        <button
          class="menu"
          aria-label={currentLocale === "es" ? "Abrir menú" : "Open menu"}
          onclick="document.querySelector('.navlinks').classList.toggle('open')"
          >☰</button
        >
      </div>
    </header>
    <main><slot /></main>
    <a
      class="whatsapp"
      href={`https://wa.me/${site.contact.whatsapp}?text=${encodeURIComponent(locale === "es" ? "Hola Bernardin, me comunico desde el sitio web." : "Hi Bernardin, I am contacting you from the website.")}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={locale === "es"
        ? "Contactar por WhatsApp"
        : "Contact Bernardin on WhatsApp"}
      ><svg viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M20.52 3.48A11.84 11.84 0 0 0 12.08 0C5.53 0 .2 5.33.2 11.88c0 2.1.55 4.15 1.59 5.96L.1 24l6.3-1.65a11.83 11.83 0 0 0 5.68 1.45h.01c6.55 0 11.88-5.33 11.88-11.88 0-3.18-1.24-6.17-3.45-8.44ZM12.09 21.8h-.01a9.84 9.84 0 0 1-5.02-1.37l-.36-.21-3.74.98 1-3.65-.23-.38a9.84 9.84 0 1 1 8.36 4.63Zm5.4-7.38c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.09 4.49.71.31 1.27.5 1.7.64.72.23 1.37.2 1.89.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"
        ></path></svg
      ></a
    >
    <footer class="footer">
      <div class="container footer-grid">
        <div>
          <a class="logo" href={home}
            ><img src={site.theme.footerLogo} alt={logoAlt} /></a
          ><p>
            {
              locale === "es"
                ? "Maquinaria agrícola para producir mejor."
                : "Agricultural machinery to produce better."
            }
          </p>
        </div>
        <div>
          <h3>{locale === "es" ? "Explorá" : "Explore"}</h3>{
            nav
              .slice(0, 4)
              .map(([label, href]: NavItem) => <a href={href}>{label}</a>)
          }
        </div>
        <div>
          <h3>{locale === "es" ? "Contacto" : "Contact"}</h3><a
            href={`mailto:${site.contact.email}`}>{site.contact.email}</a
          ><a href={`https://wa.me/${site.contact.whatsapp}`} target="_blank"
            >WhatsApp</a
          >
          <a
            href={`https://maps.google.com/?q=${encodeURIComponent(site.contact.address)}`}
            target="_blank"
          >
            <span>{site.contact.address}</span>
          </a>
        </div>
      </div>
      <div class="container">
        <small class="footer-bottom">
          <span
            >© {new Date().getFullYear()} Bernardin Máquinas Agrícolas. {
              locale === "es"
                ? "Todos los derechos reservados."
                : "All rights reserved."
            }</span
          ><a
            href="http://harvi.digital/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="credit"
              >{locale === "es" ? "Desarrollado por " : "Developed by "}
              Harvi Digital</span
            ></a
          >
        </small>
      </div>
    </footer>
  </body>
</html>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
  }
  .logo img {
    width: 190px;
    height: 48px;
    object-fit: contain;
    object-position: left center;
  }
  .whatsapp svg {
    width: 27px;
    height: 27px;
    display: block;
    fill: currentColor;
  }
  .language-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--blue);
    transition: 0.2s;
  }
  .language-toggle:hover {
    border-color: var(--blue);
    background: var(--pale);
  }
  .language-option {
    opacity: 0.5;
  }
  .language-option.active {
    opacity: 1;
    font-weight: 700;
  }
  .language-divider {
    opacity: 0.35;
  }
  .navlinks.open {
    display: flex;
    position: absolute;
    top: 78px;
    left: 0;
    right: 0;
    padding: 24px;
    background: white;
    flex-direction: column;
    box-shadow: var(--shadow);
  }
  .footer .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
  }
  .footer .credit {
    font-size: 0.85em;
    opacity: 0.7;
  }
  .footer .credit a {
    display: inline;
    margin: 0;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
  }
  .footer .credit a:hover {
    color: var(--lime);
    transform: none;
    text-decoration-color: currentColor;
  }
  @media (max-width: 700px) {
    .navlinks {
      display: none;
    }
    .menu {
      display: block;
    }
  }
</style>
