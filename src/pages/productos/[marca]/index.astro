---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import site from "../../../data/site.json";
import { cms } from "../../../lib/cms";
import type { Category } from "../../../lib/cms/types";

export function getStaticPaths() {
    return site.brands.map((b) => ({
        params: { marca: b.id },
        props: { brand: b },
    }));
}

const { brand } = Astro.props;
const [{ products }, allCategories] = await Promise.all([
    cms.products.list({ locale: "es", category: brand.id, limit: 100 }),
    cms.categories.list(),
]).catch(() => [{ products: [] as import("../../../lib/cms/types").Product[] }, [] as import("../../../lib/cms/types").Category[]]);
const uniqueTypes = [
    ...new Set(products.map((p) => p.productType).filter(Boolean)),
] as string[];
const getCat = (slug: string): Category | undefined =>
    allCategories.find((c) => c.slug === slug);
---

<BaseLayout locale="es" title={`${brand.name} | Bernardin`}>
    <section class="page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/productos">Productos</a> / {brand.name}
            </div>
            <img
                class="brand-logo-hero"
                src={brand.logo}
                alt={`Logo de ${brand.name}`}
            />
            <h1>{brand.name}</h1>
            <p>{brand.tag}</p>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="brand-strip" aria-label="Marcas Bernardin">
                {
                    site.brands.map((b) => (
                        <a
                            class:list={{ active: b.id === brand.id }}
                            href={`/productos/${b.id}`}
                        >
                            <img src={b.logo} alt={b.name} />
                        </a>
                    ))
                }
            </div>

            <div class="products-column">
                {
                    uniqueTypes.map((typeSlug) => {
                        const cat = getCat(typeSlug);
                        const items = products.filter(
                            (p) => p.productType === typeSlug,
                        );
                        return (
                            <article class="category">
                                <header>
                                    <div>
                                        <span class="eyebrow">{brand.name}</span>
                                        <h2>{cat?.name ?? typeSlug}</h2>
                                    </div>
                                </header>
                                <p>{cat?.description ?? ""}</p>
                                <div class="items">
                                    {items.map((p) => (
                                        <article class="product-card">
                                            <div class="product-media">
                                                <img
                                                    src={p.images?.[0] ?? brand.logo}
                                                    alt={p.locale?.title ?? p.slug}
                                                />
                                            </div>
                                            <h3>
                                                <a
                                                    href={`/productos/${brand.id}/${p.slug}`}
                                                >
                                                    {p.locale?.title ?? p.slug}
                                                </a>
                                            </h3>
                                        </article>
                                    ))}
                                </div>
                            </article>
                        );
                    })
                }
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .brand-logo-hero {
        width: 210px;
        height: 60px;
        object-fit: contain;
        object-position: left;
        margin: 24px 0 18px;
    }

    .brand-strip {
        display: flex;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
        margin: 0 auto 56px;
    }

    .brand-strip a {
        display: grid;
        place-items: center;
        min-width: 150px;
        min-height: 62px;
        padding: 12px 18px;
        background: var(--pale, #f4f8f4);
        border: 1px solid var(--line, #d9e2da);
        border-radius: 12px;
        transition:
            transform 180ms ease,
            border-color 180ms ease,
            box-shadow 180ms ease;
    }

    .brand-strip a:hover,
    .brand-strip a:focus-visible {
        transform: translateY(-3px);
        border-color: var(--green, #257446);
        box-shadow: 0 10px 24px rgba(25, 67, 40, 0.12);
    }

    .brand-strip a.active {
        border: 2px solid var(--green, #257446);
        background: #fff;
        box-shadow: 0 8px 20px rgba(25, 67, 40, 0.14);
    }

    .brand-strip img {
        width: 130px;
        height: 36px;
        object-fit: contain;
    }

    .products-column {
        max-width: 980px;
        margin: 0 auto;
    }

    .category {
        margin-bottom: 42px;
        padding: clamp(28px, 4vw, 48px);
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid var(--line, #d9e2da);
        border-radius: 20px;
        box-shadow: 0 12px 30px rgba(25, 67, 40, 0.06);
    }

    .category header {
        padding-bottom: 18px;
        border-bottom: 1px solid rgba(37, 116, 70, 0.14);
    }

    .category h2 {
        margin: 8px 0 0;
        color: var(--green, #257446);
        font-size: clamp(1.7rem, 4vw, 3rem);
        line-height: 1.08;
        overflow-wrap: anywhere;
    }

    .category > p {
        max-width: 680px;
        margin: 22px 0 0;
        color: var(--texto-suave, #5b675e);
        line-height: 1.7;
    }

    .items {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
        margin-top: 30px;
    }

    .product-card {
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-width: 0;
        background: #fff;
        border: 1px solid var(--line, #d9e2da);
        border-radius: 14px;
        box-shadow: 0 5px 16px rgba(25, 67, 40, 0.06);
        transition:
            transform 180ms ease,
            box-shadow 180ms ease,
            border-color 180ms ease;
    }

    .product-card::before {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 3px;
        background: var(--green, #257446);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 180ms ease;
        z-index: 2;
    }

    .product-card:hover {
        transform: translateY(-5px);
        border-color: rgba(37, 116, 70, 0.35);
        box-shadow: 0 16px 30px rgba(25, 67, 40, 0.13);
    }

    .product-card:hover::before {
        transform: scaleX(1);
    }

    .product-media {
        display: grid;
        place-items: center;
        min-height: 210px;
        padding: 32px;
        background:
            radial-gradient(
                circle at 50% 45%,
                rgba(64, 181, 83, 0.1),
                transparent 66%
            ),
            var(--pale, #f4f8f4);
        border-bottom: 1px solid rgba(37, 116, 70, 0.1);
    }

    .product-media img {
        width: 100%;
        height: 150px;
        object-fit: contain;
        transition: transform 300ms ease;
    }

    .product-card:hover .product-media img {
        transform: scale(1.045);
    }

    .product-card h3 {
        margin: 0;
        padding: 20px 24px 22px;
        color: var(--green, #257446);
        font-family: var(--fuente-display);
        font-size: var(--text-lg, 1.15rem);
        font-weight: var(--peso-bold, 700);
        line-height: 1.3;
    }

    @media (max-width: 700px) {
        .brand-strip {
            margin-bottom: 38px;
        }
        .brand-strip a {
            min-width: 132px;
        }
        .category {
            padding: 24px 18px;
            border-radius: 16px;
        }
        .items {
            grid-template-columns: 1fr;
            gap: 18px;
        }
        .product-media {
            min-height: 190px;
            padding: 26px;
        }
        .product-media img {
            height: 140px;
        }
        .product-card h3 {
            padding: 18px 20px 20px;
        }
    }
</style>
