---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import site from "../../../data/site.json";
import { cms } from "../../../lib/cms";
import type { Product } from "../../../lib/cms/types";

export async function getStaticPaths() {
    try {
        const results = await Promise.all(
            site.brands.map((b) =>
                cms.products
                    .list({ locale: "es", category: b.id, limit: 100 })
                    .then(({ products }) =>
                        products.map((p) => ({
                            params: { marca: b.id, producto: p.slug },
                            props: { product: p, brandId: b.id },
                        })),
                    ),
            ),
        );
        return results.flat();
    } catch {
        return [];
    }
}

const { product, brandId } = Astro.props as {
    product: Product;
    brandId: string;
};
const brand = site.brands.find((b) => b.id === brandId)!;
const allCategories = await cms.categories.list().catch(() => []);
const category = allCategories.find((c) => c.slug === product.productType);
const images = product.images?.length ? product.images : [brand.logo];
const productName = product.locale?.title ?? product.slug;
const productDesc =
    product.locale?.description ?? category?.description ?? "";
---

<BaseLayout locale="es" title={`${productName} | ${brand.name} | Bernardin`}>
    <section class="page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/productos">Productos</a> / <a
                    href={`/productos/${brand.id}`}>{brand.name}</a
                > / {productName}
            </div><span class="eyebrow">{brand.name}</span><h1>
                {productName}
            </h1><p>{productDesc}</p>
        </div>
    </section>
    <section class="section">
        <div class="container product-detail">
            <div class="product-gallery">
                <div class="gallery-main">
                    <img src={images[0]} alt={productName} />
                </div>{
                    images.length > 1 && (
                        <div class="gallery-thumbs">
                            {images.map((image, index) => (
                                <a href={`#media-${index}`}>
                                    <img
                                        id={`media-${index}`}
                                        src={image}
                                        alt={`${productName}, imagen ${index + 1}`}
                                    />
                                </a>
                            ))}
                        </div>
                    )
                }
            </div><div class="product-copy">
                <span class="eyebrow">{category?.name ?? ""}</span><h2>
                    Una solución pensada para tu campo.
                </h2><p>
                    {
                        productDesc ||
                            `Conocé ${productName}, una propuesta de ${brand.name} para trabajar con precisión, rendimiento y respaldo técnico.`
                    }
                </p><a
                    class="btn"
                    href={`/contacto?producto=${encodeURIComponent(productName)}`}
                    >Consultar por este producto <span>→</span></a>
            </div>
        </div>
    </section>
</BaseLayout>
<style>
    .product-detail {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
        gap: clamp(34px, 7vw, 90px);
        align-items: center;
    }
    .gallery-main {
        display: grid;
        place-items: center;
        min-height: 420px;
        padding: 48px;
        border: 1px solid var(--line);
        border-radius: 22px;
        background:
            radial-gradient(
                circle at 50% 45%,
                rgba(64, 181, 83, 0.12),
                transparent 65%
            ),
            var(--pale);
        box-shadow: var(--shadow);
    }
    .gallery-main img {
        width: 100%;
        height: 330px;
        object-fit: contain;
    }
    .gallery-thumbs {
        display: flex;
        gap: 12px;
        margin-top: 16px;
    }
    .gallery-thumbs a {
        padding: 6px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #fff;
    }
    .gallery-thumbs img {
        width: 74px;
        height: 58px;
        object-fit: cover;
    }
    .product-copy h2 {
        margin: 12px 0 20px;
    }
    .product-copy p {
        max-width: 520px;
        margin-bottom: 30px;
        color: #5b675e;
    }
    @media (max-width: 760px) {
        .product-detail {
            grid-template-columns: 1fr;
        }
        .gallery-main {
            min-height: 280px;
            padding: 28px;
        }
        .gallery-main img {
            height: 240px;
        }
    }
</style>
