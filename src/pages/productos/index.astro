---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site.json";
import { cms } from "../../lib/cms";
import { getTypeNamesForProduct, getBrandIdForProduct, slugifyType } from "../../lib/products-utils";
import type { Product } from "../../lib/cms/types";

interface ProductosHeaderData { txt_h1?: string; txt_descripcion?: string; txt_ver_productos?: string; }

const [{ components }, { products: allProducts }] = await Promise.all([
    cms.components.list({ page_filter: "Productos", locale: "es" }).catch(() => ({ components: [] })),
    cms.products.list({ locale: "es", limit: 500 }).catch(() => ({ products: [] as Product[] })),
]);
const productosHeader = cms.components.getByType<ProductosHeaderData>(components, "productos_header");
const typeNames = [...new Set(allProducts.flatMap((p) => getTypeNamesForProduct(p)))].sort((a, b) => a.localeCompare(b, "es"));

const enrichedProducts = allProducts
    .map((p) => {
        const brandId = getBrandIdForProduct(p);
        const brand = site.brands.find((b) => b.id === brandId);
        const types = getTypeNamesForProduct(p);
        return { product: p, brandId, brand, types };
    })
    .filter((e) => e.brandId);
---

<BaseLayout locale="es" title="Productos | Bernardin">
    <section class="page-hero">
        <div class="container">
            <div class="breadcrumbs"><a href="/">Inicio</a> / Productos</div>
            <h1>{productosHeader?.txt_h1}</h1>
            <p>{productosHeader?.txt_descripcion}</p>
        </div>
    </section>

    <!-- ── search + filters ───────────────────────────── -->
    <div class="search-bar-outer">
        <div class="container">
            <div class="controls-row">

                <!-- text search -->
                <div class="ctrl search-ctrl">
                    <svg class="ctrl-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6"/>
                        <path d="M13 13l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                    <input id="product-search" type="search" placeholder="Buscar productos..." autocomplete="off" />
                </div>

                <!-- marca styled select -->
                <div class="ctrl select-ctrl" id="marca-wrap">
                    <button class="ctrl-btn" id="marca-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
                        <span id="marca-label">Todas las marcas</span>
                        <svg class="ctrl-chevron" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                            <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <ul class="ctrl-panel hidden" id="marca-panel" role="listbox">
                        <li class="ctrl-option active" data-value="" data-label="Todas las marcas" role="option">Todas las marcas</li>
                        {site.brands.map((b) => (
                            <li class="ctrl-option" data-value={b.id} data-label={b.name} role="option">{b.name}</li>
                        ))}
                    </ul>
                </div>

                <!-- tipo combobox -->
                <div class="ctrl combo-ctrl" id="tipo-wrap">
                    <input
                        id="tipo-combo"
                        class="ctrl-combo-input"
                        type="text"
                        placeholder="Todos los tipos"
                        autocomplete="off"
                        role="combobox"
                        aria-expanded="false"
                        aria-haspopup="listbox"
                        aria-autocomplete="list"
                    />
                    <svg class="ctrl-chevron" id="tipo-chevron" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                        <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <button class="ctrl-clear hidden" id="tipo-clear" type="button" aria-label="Limpiar tipo">
                        <svg viewBox="0 0 10 10" fill="none"><path d="M1 1l8 8M9 1L1 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </button>
                    <ul class="ctrl-panel hidden" id="tipo-panel" role="listbox">
                        <li class="ctrl-option active" data-value="" data-label="Todos los tipos" role="option">Todos los tipos</li>
                        {typeNames.map((name) => (
                            <li class="ctrl-option" data-value={slugifyType(name)} data-label={name} role="option">{name}</li>
                        ))}
                    </ul>
                </div>

            </div>
        </div>
    </div>

    <!-- ── results ────────────────────────────────────── -->
    <section class="section results-section hidden" id="results-section">
        <div class="container">
            <p class="result-count hidden" id="result-count"></p>
            <div class="products-grid" id="products-grid">
                {
                    enrichedProducts.map(({ product, brandId, brand, types }) => (
                        <article
                            class="product-card hidden"
                            data-nombre={(product.locale?.title ?? product.slug).toLowerCase()}
                            data-marca={brandId}
                            data-tipo={types.map(slugifyType).join("|")}
                        >
                            <a href={`/productos/${brandId}/${product.slug}`}>
                                <div class="card-media">
                                    <img src={product.images?.[0] ?? brand?.logo ?? ""} alt={product.locale?.title ?? product.slug} loading="lazy" />
                                </div>
                                {brand && <span class="card-brand">{brand.name}</span>}
                                <h3>{product.locale?.title ?? product.slug}</h3>
                            </a>
                        </article>
                    ))
                }
            </div>
            <p class="no-results hidden" id="no-results">Sin resultados para tu búsqueda.</p>
        </div>
    </section>

    <!-- ── brand grid ─────────────────────────────────── -->
    <section class="section" id="browse-section">
        <div class="container">
            <div class="brand-grid">
                {
                    site.brands.map((b) => (
                        <a class="brand-card brand-card-logo" href={`/productos/${b.id}`}>
                            <>
                                <img src={b.logo} alt={`Logo de ${b.name}`} />
                                <p>{b.tag}</p>
                                <span class="arrow">{productosHeader?.txt_ver_productos}</span>
                            </>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ── tipo chips (seo) ───────────────────────────── -->
    <section class="section tipo-section">
        <div class="container">
            <h2 class="tipo-title">Explorar por tipo</h2>
            <div class="tipo-chips">
                {typeNames.map((name) => (
                    <a class="tipo-chip" href={`/productos/tipo/${slugifyType(name)}`}>{name}</a>
                ))}
            </div>
        </div>
    </section>
</BaseLayout>

<script is:inline>
(function () {
    var searchInput   = document.getElementById("product-search");
    var cards         = document.querySelectorAll(".product-card");
    var countEl       = document.getElementById("result-count");
    var noResultsEl   = document.getElementById("no-results");
    var resultSection = document.getElementById("results-section");
    var browseSection = document.getElementById("browse-section");

    var activeMarca = "";
    var activeTipo  = "";

    /* ── filter engine ── */
    function filter() {
        var q = searchInput.value.toLowerCase().trim();
        var hasFilter = q || activeMarca || activeTipo;
        if (!hasFilter) {
            cards.forEach(function (c) { c.classList.add("hidden"); });
            countEl.classList.add("hidden");
            noResultsEl.classList.add("hidden");
            resultSection.classList.add("hidden");
            browseSection.classList.remove("hidden");
            return;
        }
        browseSection.classList.add("hidden");
        resultSection.classList.remove("hidden");
        var count = 0;
        cards.forEach(function (card) {
            var show =
                (!q || (card.dataset.nombre || "").includes(q)) &&
                (!activeMarca || card.dataset.marca === activeMarca) &&
                (!activeTipo  || (card.dataset.tipo  || "").split("|").includes(activeTipo));
            card.classList.toggle("hidden", !show);
            if (show) count++;
        });
        countEl.textContent = count + " producto" + (count !== 1 ? "s" : "");
        countEl.classList.remove("hidden");
        noResultsEl.classList.toggle("hidden", count > 0);
    }

    searchInput.addEventListener("input", filter);

    /* ── generic dropdown ── */
    function makeDropdown(wrapperId, triggerId, labelId, panelId) {
        var wrap    = document.getElementById(wrapperId);
        var trigger = document.getElementById(triggerId);
        var label   = document.getElementById(labelId);
        var panel   = document.getElementById(panelId);
        var items   = panel.querySelectorAll(".ctrl-option");

        function open()  { panel.classList.remove("hidden"); trigger.setAttribute("aria-expanded","true"); }
        function close() { panel.classList.add("hidden");    trigger.setAttribute("aria-expanded","false"); }

        trigger.addEventListener("click", function () {
            panel.classList.contains("hidden") ? open() : close();
        });
        items.forEach(function (item) {
            item.addEventListener("click", function () {
                items.forEach(function (i) { i.classList.remove("active"); });
                item.classList.add("active");
                label.textContent = item.dataset.label;
                activeMarca = item.dataset.value;
                close();
                filter();
            });
        });
        document.addEventListener("click", function (e) {
            if (!wrap.contains(e.target)) close();
        });
    }
    makeDropdown("marca-wrap", "marca-trigger", "marca-label", "marca-panel");

    /* ── tipo combobox ── */
    var tipoWrap   = document.getElementById("tipo-wrap");
    var tipoInput  = document.getElementById("tipo-combo");
    var tipoPanel  = document.getElementById("tipo-panel");
    var tipoChevron= document.getElementById("tipo-chevron");
    var tipoClear  = document.getElementById("tipo-clear");
    var tipoItems  = tipoPanel.querySelectorAll(".ctrl-option");

    function tipoOpen()  { tipoPanel.classList.remove("hidden"); tipoInput.setAttribute("aria-expanded","true");  tipoChevron.classList.add("open"); }
    function tipoClose() { tipoPanel.classList.add("hidden");    tipoInput.setAttribute("aria-expanded","false"); tipoChevron.classList.remove("open"); }

    tipoInput.addEventListener("focus", tipoOpen);
    tipoInput.addEventListener("input", function () {
        tipoOpen();
        var q = tipoInput.value.toLowerCase();
        tipoItems.forEach(function (item) {
            if (!item.dataset.value) { item.style.display = ""; return; }
            item.style.display = item.dataset.label.toLowerCase().includes(q) ? "" : "none";
        });
    });
    tipoInput.addEventListener("blur", function () {
        setTimeout(tipoClose, 160);
    });
    tipoItems.forEach(function (item) {
        item.addEventListener("mousedown", function (e) {
            e.preventDefault();
            tipoItems.forEach(function (i) { i.classList.remove("active"); });
            item.classList.add("active");
            activeTipo = item.dataset.value;
            tipoInput.value = item.dataset.value ? item.dataset.label : "";
            tipoClear.classList.toggle("hidden", !item.dataset.value);
            tipoClose();
            filter();
        });
    });
    tipoClear.addEventListener("click", function () {
        activeTipo = "";
        tipoInput.value = "";
        tipoClear.classList.add("hidden");
        tipoItems.forEach(function (i) { i.classList.remove("active"); });
        tipoItems[0].classList.add("active");
        tipoInput.focus();
        filter();
    });
    document.addEventListener("click", function (e) {
        if (!tipoWrap.contains(e.target)) tipoClose();
    });
})();
</script>

<style>
    /* ── search bar strip ─────────────────────────────── */
    .search-bar-outer {
        background: var(--pale, #f4f8f4);
        border-top: 1px solid var(--line, #d9e2da);
        border-bottom: 1px solid var(--line, #d9e2da);
        padding: 18px 0;
    }
    .controls-row {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    /* shared control shell */
    .ctrl {
        position: relative;
        height: 42px;
        display: flex;
        align-items: center;
    }
    .ctrl-icon {
        position: absolute;
        left: 12px;
        width: 16px; height: 16px;
        color: #8aab96;
        pointer-events: none;
        flex-shrink: 0;
    }
    /* shared input / button base */
    .ctrl input,
    .ctrl-btn {
        height: 42px;
        border: 1.5px solid var(--line, #d9e2da);
        border-radius: 9px;
        background: #fff;
        font-size: 0.88rem;
        color: var(--texto, #1a2e22);
        outline: none;
        box-sizing: border-box;
        transition: border-color 140ms, box-shadow 140ms;
    }
    .ctrl input:focus,
    .ctrl-btn:focus,
    .ctrl-btn[aria-expanded="true"],
    .ctrl-combo-input[aria-expanded="true"] {
        border-color: var(--green, #257446);
        box-shadow: 0 0 0 3px rgba(37,116,70,.1);
    }

    /* text search */
    .search-ctrl { flex: 1 1 220px; }
    #product-search {
        width: 100%;
        padding: 0 14px 0 36px;
    }
    #product-search::placeholder { color: #9bb5a4; }

    /* marca dropdown trigger */
    .select-ctrl { flex: 0 0 auto; }
    .ctrl-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 12px;
        min-width: 160px;
        justify-content: space-between;
        cursor: pointer;
        font-weight: 500;
        white-space: nowrap;
        font-family: inherit;
    }
    .ctrl-chevron {
        width: 10px; height: 7px;
        color: #7a9985;
        flex-shrink: 0;
        transition: transform 160ms ease;
        pointer-events: none;
    }
    .ctrl-btn[aria-expanded="true"] .ctrl-chevron,
    .ctrl-chevron.open { transform: rotate(180deg); }

    /* tipo combobox */
    .combo-ctrl { flex: 0 0 auto; }
    .ctrl-combo-input {
        padding: 0 52px 0 12px;
        min-width: 190px;
        cursor: pointer;
        font-weight: 500;
        font-family: inherit;
        caret-color: var(--green, #257446);
    }
    .ctrl-combo-input::placeholder { color: var(--texto, #1a2e22); font-weight: 500; }
    /* chevron & clear inside combobox */
    .combo-ctrl .ctrl-chevron {
        position: absolute;
        right: 30px;
        pointer-events: none;
    }
    .ctrl-clear {
        position: absolute;
        right: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 20px; height: 20px;
        border: none;
        background: none;
        cursor: pointer;
        color: #9bb5a4;
        padding: 0;
        border-radius: 4px;
        transition: color 120ms;
    }
    .ctrl-clear:hover { color: var(--texto, #1a2e22); }
    .ctrl-clear svg { width: 10px; height: 10px; }

    /* shared dropdown panel */
    .ctrl-panel {
        position: absolute;
        top: calc(100% + 5px);
        left: 0;
        min-width: 100%;
        max-height: 280px;
        overflow-y: auto;
        list-style: none;
        margin: 0;
        padding: 5px 0;
        background: #fff;
        border: 1.5px solid var(--line, #d9e2da);
        border-radius: 10px;
        box-shadow: 0 6px 24px rgba(25,67,40,.12);
        z-index: 50;
    }
    .ctrl-option {
        padding: 8px 14px;
        font-size: 0.87rem;
        cursor: pointer;
        color: var(--texto, #1a2e22);
        transition: background 100ms;
        white-space: nowrap;
    }
    .ctrl-option:hover { background: var(--pale, #f4f8f4); }
    .ctrl-option.active { color: var(--green, #257446); font-weight: 600; background: rgba(37,116,70,.06); }
    .hidden { display: none !important; }

    /* ── results section ──────────────────────────────── */
    .results-section { padding-top: 32px; }
    .result-count { margin: 0 0 14px; font-size: 0.82rem; color: #7a9985; font-weight: 500; }
    .no-results    { padding: 44px 0; text-align: center; color: #7a9985;  font-size: 0.93rem; }

    /* ── product grid ─────────────────────────────────── */
    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 16px;
    }
    .product-card a {
        display: flex; flex-direction: column; height: 100%;
        background: #fff; border: 1px solid var(--line, #d9e2da); border-radius: 12px;
        overflow: hidden; text-decoration: none; transition: transform 160ms, box-shadow 160ms;
    }
    .product-card a:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(25,67,40,.11); }
    .card-media {
        display: grid; place-items: center; height: 150px; padding: 20px;
        background: radial-gradient(circle at 50% 45%, rgba(64,181,83,.08), transparent 65%), var(--pale, #f4f8f4);
        border-bottom: 1px solid rgba(37,116,70,.08);
    }
    .card-media img { width: 100%; height: 100%; object-fit: contain; }
    .card-brand { padding: 10px 14px 0; font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--green, #257446); }
    .product-card h3 { margin: 0; padding: 6px 14px 16px; font-size: .9rem; font-weight: 600; line-height: 1.35; color: var(--texto, #1a2e22); }

    /* ── brand grid ───────────────────────────────────── */
    .brand-grid { grid-template-columns: repeat(6, 1fr); gap: 18px; }
    .brand-card-logo {
        display: flex; min-height: 220px; flex-direction: column; align-items: flex-start;
        justify-content: space-between; padding: 28px 26px; border: 1px solid var(--line);
        border-radius: 8px; background: var(--white); box-shadow: var(--shadow); overflow: hidden;
    }
    .brand-card-logo:nth-child(1) { grid-column: 1 / span 2; }
    .brand-card-logo:nth-child(2) { grid-column: 3 / span 2; }
    .brand-card-logo:nth-child(3) { grid-column: 5 / span 2; }
    .brand-card-logo:nth-child(4) { grid-column: 2 / span 2; }
    .brand-card-logo:nth-child(5) { grid-column: 4 / span 2; }
    .brand-card-logo img { width: min(100%, 220px); height: 72px; object-fit: contain; object-position: left center; }
    .brand-card-logo p { margin: 18px 0 0; color: #566b60; max-width: 22ch; }
    .arrow { color: var(--blue); font-weight: 700; text-transform: uppercase; font-size: .78rem; letter-spacing: .06em; white-space: nowrap; }

    /* ── tipo section ─────────────────────────────────── */
    .tipo-section { background: #fff; border-top: 1px solid var(--line, #d9e2da); }
    .tipo-title { margin: 0 0 32px; font-size: clamp(1.4rem, 3vw, 2rem); color: var(--green, #257446); }
    .tipo-chips { display: flex; flex-wrap: wrap; gap: 10px; }
    .tipo-chip {
        display: inline-block; padding: 8px 18px; background: var(--pale, #f4f8f4);
        border: 1px solid var(--line, #d9e2da); border-radius: 999px; font-size: .88rem;
        font-weight: 500; color: var(--green, #257446); text-decoration: none;
        transition: background 180ms, border-color 180ms, color 180ms;
    }
    .tipo-chip:hover { background: var(--green, #257446); border-color: var(--green, #257446); color: #fff; }

    /* ── mobile ───────────────────────────────────────── */
    @media (max-width: 700px) {
        .controls-row { flex-direction: column; align-items: stretch; }
        .ctrl { height: 44px; }
        .ctrl-btn,
        .ctrl-combo-input { min-width: 0; width: 100%; }
        .search-ctrl { flex: unset; }
        .ctrl-panel { position: fixed; top: auto; left: 1rem; right: 1rem; bottom: 1rem; max-height: 55vh; border-radius: 14px; }
        .brand-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        .brand-card-logo,
        .brand-card-logo:nth-child(n) { grid-column: auto; min-height: 205px; padding: 22px 18px; }
        .brand-card-logo:nth-child(5) { grid-column: 1 / -1; max-width: calc(50% - 7px); width: 100%; justify-self: center; }
        .brand-card-logo img { width: 100%; height: 58px; object-position: center; }
        .brand-card-logo p { font-size: .95rem; line-height: 1.35; margin-top: 14px; }
        .arrow { font-size: .68rem; }
        .products-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
        .card-media { height: 120px; }
    }
</style>
