---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site.json";
---

<BaseLayout locale="es" title="Productos | Alfaterra"
    ><section class="page-hero">
        <div class="container">
            <div class="breadcrumbs">Inicio / Productos</div><h1>
                Marcas que trabajan con vos.
            </h1><p>
                Alfaterra comercializa cinco marcas internacionales, cada una
                con soluciones específicas para el campo.
            </p>
        </div>
    </section><section class="section">
        <div class="container">
            <div class="brand-grid">
                {
                    site.brands.map((b) => (
                        <a
                            class="brand-card brand-card-logo"
                            href={`/productos/${b.id}`}
                        >
                            <>
                                <img src={b.logo} alt={`Logo de ${b.name}`} />
                                <p>{b.tag}</p>
                                <span class="arrow">Ver productos →</span>
                            </>
                        </a>
                    ))
                }
            </div>
        </div>
    </section></BaseLayout
>
<style>
    .brand-grid {
        grid-template-columns: repeat(6, 1fr);
    }
    .brand-card-logo {
        display: flex;
        min-height: 220px;
        flex-direction: column;
        align-items: flex-start;
        justify-content: space-between;
    }
    .brand-card-logo:nth-child(1) {
        grid-column: 1 / span 2;
    }
    .brand-card-logo:nth-child(2) {
        grid-column: 3 / span 2;
    }
    .brand-card-logo:nth-child(3) {
        grid-column: 5 / span 2;
    }
    .brand-card-logo:nth-child(4) {
        grid-column: 2 / span 2;
    }
    .brand-card-logo:nth-child(5) {
        grid-column: 4 / span 2;
    }
    .brand-card-logo img {
        width: min(100%, 220px);
        height: 72px;
        object-fit: contain;
        object-position: left center;
    }
    .brand-card-logo p {
        margin: 0;
        color: #566b60;
    }
    .arrow {
        color: var(--blue);
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.78rem;
        letter-spacing: 0.06em;
    }
</style>
