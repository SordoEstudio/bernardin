---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site.json";
import { cms } from "../../lib/cms";
import { getTypeNamesForProduct, getBrandIdForProduct, slugifyType } from "../../lib/products-utils";
import type { Product } from "../../lib/cms/types";
import '../../styles/products-index.css';

interface ProductosHeaderData { txt_h1?: string; txt_descripcion?: string; txt_ver_productos?: string; }

const [{ components }, { products: allProducts }] = await Promise.all([
    cms.components.list({ page_filter: "Productos", locale: "es" }).catch(() => ({ components: [] })),
    cms.products.list({ locale: "es", limit: 500 }).catch(() => ({ products: [] as Product[] })),
]);
const productosHeader = cms.components.getByType<ProductosHeaderData>(components, "productos_header");
const typeNames = [...new Set(allProducts.flatMap((p) => getTypeNamesForProduct(p)))].sort((a, b) => a.localeCompare(b, "es"));

const enrichedProducts = allProducts
    .map((p) => {
        const brandId = getBrandIdForProduct(p);
        const brand = site.brands.find((b) => b.id === brandId);
        const types = getTypeNamesForProduct(p);
        return { product: p, brandId, brand, types };
    })
    .filter((e) => e.brandId);
---

<BaseLayout locale="es" title="Productos | Bernardin">
    <section class="page-hero">
        <div class="container">
            <div class="breadcrumbs"><a href="/">Inicio</a> / Productos</div>
            <h1>{productosHeader?.txt_h1}</h1>
            <p>{productosHeader?.txt_descripcion}</p>
            <div class="brand-strip" aria-label="Marcas Bernardin">
                {site.brands.map((b) => (
                    <a href={`/productos/${b.id}`}>
                        <img src={b.logo} alt={b.name} />
                    </a>
                ))}
            </div>
        </div>
    </section>

    <!-- ── search + filters ───────────────────────────── -->
    <div class="search-bar-outer">
        <div class="container">
            <div class="controls-row">

                <!-- text search -->
                <div class="ctrl search-ctrl">
                    <svg class="ctrl-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6"/>
                        <path d="M13 13l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                    <input id="product-search" type="search" placeholder="Buscar productos..." autocomplete="off" />
                </div>

                <!-- marca styled select -->
                <div class="ctrl select-ctrl" id="marca-wrap">
                    <button class="ctrl-btn" id="marca-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
                        <span id="marca-label">Todas las marcas</span>
                        <svg class="ctrl-chevron" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                            <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <ul class="ctrl-panel hidden" id="marca-panel" role="listbox">
                        <li class="ctrl-option active" data-value="" data-label="Todas las marcas" role="option">Todas las marcas</li>
                        {site.brands.map((b) => (
                            <li class="ctrl-option" data-value={b.id} data-label={b.name} role="option">{b.name}</li>
                        ))}
                    </ul>
                </div>

                <!-- tipo combobox -->
                <div class="ctrl combo-ctrl" id="tipo-wrap">
                    <input
                        id="tipo-combo"
                        class="ctrl-combo-input"
                        type="text"
                        placeholder="Todos los tipos"
                        autocomplete="off"
                        role="combobox"
                        aria-expanded="false"
                        aria-haspopup="listbox"
                        aria-autocomplete="list"
                    />
                    <svg class="ctrl-chevron" id="tipo-chevron" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                        <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <button class="ctrl-clear hidden" id="tipo-clear" type="button" aria-label="Limpiar tipo">
                        <svg viewBox="0 0 10 10" fill="none"><path d="M1 1l8 8M9 1L1 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </button>
                    <ul class="ctrl-panel hidden" id="tipo-panel" role="listbox">
                        <li class="ctrl-option active" data-value="" data-label="Todos los tipos" role="option">Todos los tipos</li>
                        {typeNames.map((name) => (
                            <li class="ctrl-option" data-value={slugifyType(name)} data-label={name} role="option">{name}</li>
                        ))}
                    </ul>
                </div>

            </div>
        </div>
    </div>

    <!-- ── results ────────────────────────────────────── -->
    <section class="section results-section hidden" id="results-section">
        <div class="container">
            <p class="result-count hidden" id="result-count"></p>
            <div class="products-grid" id="products-grid">
                {
                    enrichedProducts.map(({ product, brandId, brand, types }) => (
                        <article
                            class="product-card hidden"
                            data-nombre={(product.locale?.title ?? product.slug).toLowerCase()}
                            data-marca={brandId}
                            data-tipo={types.map(slugifyType).join("|")}
                        >
                            <a href={`/productos/${brandId}/${product.slug}`}>
                                <div class="card-media">
                                    <img src={product.images?.[0] ?? brand?.logo ?? ""} alt={product.locale?.title ?? product.slug} loading="lazy" />
                                </div>
                                {brand && <span class="card-brand">{brand.name}</span>}
                                <h3>{product.locale?.title ?? product.slug}</h3>
                            </a>
                        </article>
                    ))
                }
            </div>
            <div id="reveal-sentinel" aria-hidden="true" style="height:1px;pointer-events:none"></div>
            <p class="no-results hidden" id="no-results">Sin resultados para tu búsqueda.</p>
        </div>
    </section>

    <!-- ── brand grid ─────────────────────────────────── -->
    <section class="section" id="browse-section">
        <div class="container">
            <div class="brand-grid">
                {
                    site.brands.map((b) => (
                        <a class="brand-card brand-card-logo" href={`/productos/${b.id}`}>
                            <>
                                <img src={b.logo} alt={`Logo de ${b.name}`} />
                                <p>{b.tag}</p>
                                <span class="arrow">{productosHeader?.txt_ver_productos}</span>
                            </>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ── tipo chips (seo) ───────────────────────────── -->
    <section class="section tipo-section">
        <div class="container">
            <h2 class="tipo-title">Explorar por tipo</h2>
            <div class="tipo-chips">
                {typeNames.map((name) => (
                    <a class="tipo-chip" href={`/productos/tipo/${slugifyType(name)}`}>{name}</a>
                ))}
            </div>
        </div>
    </section>
</BaseLayout>

<script is:inline>
(function () {
    var searchInput   = document.getElementById("product-search");
    var cards         = document.querySelectorAll(".product-card");
    var countEl       = document.getElementById("result-count");
    var noResultsEl   = document.getElementById("no-results");
    var resultSection = document.getElementById("results-section");
    var browseSection = document.getElementById("browse-section");

    var activeMarca = "";
    var activeTipo  = "";
    var PAGE_SIZE   = 20;
    var revealQueue = [];

    var sentinel = document.getElementById("reveal-sentinel");
    if (sentinel) {
        new IntersectionObserver(function(entries) {
            if (entries[0].isIntersecting && revealQueue.length > 0) {
                var batch = revealQueue.splice(0, PAGE_SIZE);
                batch.forEach(function(c) { c.classList.remove("hidden"); });
            }
        }, { rootMargin: "200px" }).observe(sentinel);
    }

    /* ── filter engine ── */
    function filter() {
        var q = searchInput.value.toLowerCase().trim();
        var hasFilter = q || activeMarca || activeTipo;
        if (!hasFilter) {
            cards.forEach(function (c) { c.classList.add("hidden"); });
            countEl.classList.add("hidden");
            noResultsEl.classList.add("hidden");
            resultSection.classList.add("hidden");
            browseSection.classList.remove("hidden");
            revealQueue = [];
            return;
        }
        browseSection.classList.add("hidden");
        resultSection.classList.remove("hidden");
        cards.forEach(function (c) { c.classList.add("hidden"); });
        var matching = [];
        cards.forEach(function (card) {
            var show =
                (!q || (card.dataset.nombre || "").includes(q)) &&
                (!activeMarca || card.dataset.marca === activeMarca) &&
                (!activeTipo  || (card.dataset.tipo  || "").split("|").includes(activeTipo));
            if (show) matching.push(card);
        });
        revealQueue = matching.slice(PAGE_SIZE);
        matching.slice(0, PAGE_SIZE).forEach(function (c) { c.classList.remove("hidden"); });
        var count = matching.length;
        countEl.textContent = count + " producto" + (count !== 1 ? "s" : "");
        countEl.classList.remove("hidden");
        noResultsEl.classList.toggle("hidden", count > 0);
    }

    searchInput.addEventListener("input", filter);

    /* ── generic dropdown ── */
    function makeDropdown(wrapperId, triggerId, labelId, panelId) {
        var wrap    = document.getElementById(wrapperId);
        var trigger = document.getElementById(triggerId);
        var label   = document.getElementById(labelId);
        var panel   = document.getElementById(panelId);
        var items   = panel.querySelectorAll(".ctrl-option");

        function open()  { panel.classList.remove("hidden"); trigger.setAttribute("aria-expanded","true"); }
        function close() { panel.classList.add("hidden");    trigger.setAttribute("aria-expanded","false"); }

        trigger.addEventListener("click", function () {
            panel.classList.contains("hidden") ? open() : close();
        });
        items.forEach(function (item) {
            item.addEventListener("click", function () {
                items.forEach(function (i) { i.classList.remove("active"); });
                item.classList.add("active");
                label.textContent = item.dataset.label;
                activeMarca = item.dataset.value;
                close();
                filter();
            });
        });
        document.addEventListener("click", function (e) {
            if (!wrap.contains(e.target)) close();
        });
    }
    makeDropdown("marca-wrap", "marca-trigger", "marca-label", "marca-panel");

    /* ── tipo combobox ── */
    var tipoWrap   = document.getElementById("tipo-wrap");
    var tipoInput  = document.getElementById("tipo-combo");
    var tipoPanel  = document.getElementById("tipo-panel");
    var tipoChevron= document.getElementById("tipo-chevron");
    var tipoClear  = document.getElementById("tipo-clear");
    var tipoItems  = tipoPanel.querySelectorAll(".ctrl-option");

    function tipoOpen()  { tipoPanel.classList.remove("hidden"); tipoInput.setAttribute("aria-expanded","true");  tipoChevron.classList.add("open"); }
    function tipoClose() { tipoPanel.classList.add("hidden");    tipoInput.setAttribute("aria-expanded","false"); tipoChevron.classList.remove("open"); }

    tipoInput.addEventListener("focus", tipoOpen);
    tipoInput.addEventListener("input", function () {
        tipoOpen();
        var q = tipoInput.value.toLowerCase();
        tipoItems.forEach(function (item) {
            if (!item.dataset.value) { item.style.display = ""; return; }
            item.style.display = item.dataset.label.toLowerCase().includes(q) ? "" : "none";
        });
    });
    tipoInput.addEventListener("blur", function () {
        setTimeout(tipoClose, 160);
    });
    tipoItems.forEach(function (item) {
        item.addEventListener("mousedown", function (e) {
            e.preventDefault();
            tipoItems.forEach(function (i) { i.classList.remove("active"); });
            item.classList.add("active");
            activeTipo = item.dataset.value;
            tipoInput.value = item.dataset.value ? item.dataset.label : "";
            tipoClear.classList.toggle("hidden", !item.dataset.value);
            tipoClose();
            filter();
        });
    });
    tipoClear.addEventListener("click", function () {
        activeTipo = "";
        tipoInput.value = "";
        tipoClear.classList.add("hidden");
        tipoItems.forEach(function (i) { i.classList.remove("active"); });
        tipoItems[0].classList.add("active");
        tipoInput.focus();
        filter();
    });
    document.addEventListener("click", function (e) {
        if (!tipoWrap.contains(e.target)) tipoClose();
    });
})();
</script>
