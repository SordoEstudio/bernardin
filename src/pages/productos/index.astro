---
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site.json";
import { cms } from "../../lib/cms";
import { getTypeNamesForProduct, getBrandIdForProduct, slugifyType } from "../../lib/products-utils";
import type { Product } from "../../lib/cms/types";

interface ProductosHeaderData { txt_h1?: string; txt_descripcion?: string; txt_ver_productos?: string; }

const [{ components }, { products: allProducts }] = await Promise.all([
    cms.components.list({ page_filter: "Productos", locale: "es" }).catch(() => ({ components: [] })),
    cms.products.list({ locale: "es", limit: 500 }).catch(() => ({ products: [] as Product[] })),
]);
const productosHeader = cms.components.getByType<ProductosHeaderData>(components, "productos_header");
const typeNames = [...new Set(allProducts.flatMap((p) => getTypeNamesForProduct(p)))].sort((a, b) => a.localeCompare(b, "es"));

const enrichedProducts = allProducts
    .map((p) => {
        const brandId = getBrandIdForProduct(p);
        const brand = site.brands.find((b) => b.id === brandId);
        const types = getTypeNamesForProduct(p);
        return { product: p, brandId, brand, types };
    })
    .filter((e) => e.brandId);
---

<BaseLayout locale="es" title="Productos | Bernardin">
    <section class="page-hero">
        <div class="container">
            <div class="breadcrumbs"><a href="/">Inicio</a> / Productos</div>
            <h1>{productosHeader?.txt_h1}</h1>
            <p>{productosHeader?.txt_descripcion}</p>
        </div>
    </section>

    <!-- ── search bar + filters ───────────────────────── -->
    <section class="section search-section">
        <div class="container">
            <div class="controls-row">
                <div class="search-wrap">
                    <svg class="search-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6"/>
                        <path d="M13 13l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                    <input id="product-search" type="search" placeholder="Buscar productos..." autocomplete="off" />
                </div>

                <!-- marca select -->
                <div class="select-wrap">
                    <select id="marca-select">
                        <option value="">Todas las marcas</option>
                        {site.brands.map((b) => <option value={b.id}>{b.name}</option>)}
                    </select>
                    <svg class="select-arrow" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                        <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>

                <!-- tipo searchable dropdown -->
                <div class="tipo-dropdown" id="tipo-dropdown">
                    <button class="dropdown-trigger" type="button" id="tipo-trigger" aria-expanded="false" aria-haspopup="listbox">
                        <span id="tipo-label">Todos los tipos</span>
                        <svg class="select-arrow" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                            <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <div class="dropdown-panel" id="tipo-panel" hidden>
                        <div class="dropdown-search-wrap">
                            <input class="dropdown-search" id="tipo-filter-input" type="text" placeholder="Buscar tipo..." autocomplete="off" />
                        </div>
                        <ul class="dropdown-list" id="tipo-list" role="listbox">
                            <li class="dropdown-item active" data-value="" data-label="Todos los tipos" role="option">Todos los tipos</li>
                            {typeNames.map((name) => (
                                <li class="dropdown-item" data-value={slugifyType(name)} data-label={name} role="option">{name}</li>
                            ))}
                        </ul>
                    </div>
                </div>
            </div>

            <!-- results -->
            <p class="result-count hidden" id="result-count"></p>
            <div class="products-grid" id="products-grid">
                {
                    enrichedProducts.map(({ product, brandId, brand, types }) => (
                        <article
                            class="product-card hidden"
                            data-nombre={(product.locale?.title ?? product.slug).toLowerCase()}
                            data-marca={brandId}
                            data-tipo={types.map(slugifyType).join("|")}
                        >
                            <a href={`/productos/${brandId}/${product.slug}`}>
                                <div class="card-media">
                                    <img src={product.images?.[0] ?? brand?.logo ?? ""} alt={product.locale?.title ?? product.slug} loading="lazy" />
                                </div>
                                {brand && <span class="card-brand">{brand.name}</span>}
                                <h3>{product.locale?.title ?? product.slug}</h3>
                            </a>
                        </article>
                    ))
                }
            </div>
            <p class="search-prompt" id="search-prompt">Usá el buscador o seleccioná una marca y tipo para encontrar productos.</p>
            <p class="no-results hidden" id="no-results">Sin resultados para tu búsqueda.</p>
        </div>
    </section>

    <!-- ── brand grid ─────────────────────────────────── -->
    <section class="section">
        <div class="container">
            <div class="brand-grid">
                {
                    site.brands.map((b) => (
                        <a class="brand-card brand-card-logo" href={`/productos/${b.id}`}>
                            <>
                                <img src={b.logo} alt={`Logo de ${b.name}`} />
                                <p>{b.tag}</p>
                                <span class="arrow">{productosHeader?.txt_ver_productos}</span>
                            </>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ── tipo chips (seo) ───────────────────────────── -->
    <section class="section tipo-section">
        <div class="container">
            <h2 class="tipo-title">Explorar por tipo</h2>
            <div class="tipo-chips">
                {typeNames.map((name) => (
                    <a class="tipo-chip" href={`/productos/tipo/${slugifyType(name)}`}>{name}</a>
                ))}
            </div>
        </div>
    </section>
</BaseLayout>

<script is:inline>
(function () {
    var searchInput = document.getElementById("product-search");
    var marcaSelect = document.getElementById("marca-select");
    var tipoTrigger = document.getElementById("tipo-trigger");
    var tipoLabel = document.getElementById("tipo-label");
    var tipoPanel = document.getElementById("tipo-panel");
    var tipoFilterInput = document.getElementById("tipo-filter-input");
    var tipoItems = document.querySelectorAll("#tipo-list .dropdown-item");
    var cards = document.querySelectorAll(".product-card");
    var countEl = document.getElementById("result-count");
    var promptEl = document.getElementById("search-prompt");
    var noResultsEl = document.getElementById("no-results");

    var activeMarca = "";
    var activeTipo = "";

    function filter() {
        var q = searchInput.value.toLowerCase().trim();
        var hasFilter = q || activeMarca || activeTipo;

        if (!hasFilter) {
            cards.forEach(function (c) { c.classList.add("hidden"); });
            promptEl.classList.remove("hidden");
            countEl.classList.add("hidden");
            noResultsEl.classList.add("hidden");
            return;
        }

        promptEl.classList.add("hidden");
        var count = 0;
        cards.forEach(function (card) {
            var show =
                (!q || (card.dataset.nombre || "").includes(q)) &&
                (!activeMarca || card.dataset.marca === activeMarca) &&
                (!activeTipo || (card.dataset.tipo || "").split("|").includes(activeTipo));
            card.classList.toggle("hidden", !show);
            if (show) count++;
        });
        countEl.textContent = count + " producto" + (count !== 1 ? "s" : "");
        countEl.classList.remove("hidden");
        noResultsEl.classList.toggle("hidden", count > 0);
    }

    searchInput.addEventListener("input", filter);
    marcaSelect.addEventListener("change", function () {
        activeMarca = marcaSelect.value;
        filter();
    });

    /* ── tipo dropdown ── */
    tipoTrigger.addEventListener("click", function () {
        var isOpen = !tipoPanel.hidden;
        tipoPanel.hidden = isOpen;
        tipoTrigger.setAttribute("aria-expanded", String(!isOpen));
        if (!isOpen) {
            tipoFilterInput.value = "";
            tipoItems.forEach(function (i) { i.style.display = ""; });
            tipoFilterInput.focus();
        }
    });

    tipoFilterInput.addEventListener("input", function () {
        var q = tipoFilterInput.value.toLowerCase();
        tipoItems.forEach(function (item) {
            if (!item.dataset.value) { return; } // keep "todos" always visible
            item.style.display = item.textContent.toLowerCase().includes(q) ? "" : "none";
        });
    });

    tipoItems.forEach(function (item) {
        item.addEventListener("click", function () {
            tipoItems.forEach(function (i) { i.classList.remove("active"); });
            item.classList.add("active");
            activeTipo = item.dataset.value;
            tipoLabel.textContent = item.dataset.label;
            tipoPanel.hidden = true;
            tipoTrigger.setAttribute("aria-expanded", "false");
            filter();
        });
    });

    document.addEventListener("click", function (e) {
        if (!document.getElementById("tipo-dropdown").contains(e.target)) {
            tipoPanel.hidden = true;
            tipoTrigger.setAttribute("aria-expanded", "false");
        }
    });
})();
</script>

<style>
    /* ── controls row ─────────────────────────────────── */
    .search-section {
        background: var(--pale, #f4f8f4);
        border-top: 1px solid var(--line, #d9e2da);
        border-bottom: 1px solid var(--line, #d9e2da);
    }
    .controls-row {
        display: flex;
        gap: 12px;
        align-items: stretch;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    /* search input */
    .search-wrap {
        position: relative;
        flex: 1 1 240px;
    }
    .search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 17px;
        height: 17px;
        color: #8aab96;
        pointer-events: none;
    }
    #product-search {
        width: 100%;
        height: 46px;
        padding: 0 16px 0 42px;
        font-size: 0.95rem;
        border: 1.5px solid var(--line, #d9e2da);
        border-radius: 10px;
        background: #fff;
        color: var(--texto, #1a2e22);
        outline: none;
        box-sizing: border-box;
        transition: border-color 150ms, box-shadow 150ms;
    }
    #product-search:focus {
        border-color: var(--green, #257446);
        box-shadow: 0 0 0 3px rgba(37,116,70,.1);
    }
    #product-search::placeholder { color: #9bb5a4; }

    /* shared control base */
    .select-wrap,
    .tipo-dropdown { flex: 0 0 auto; position: relative; }

    /* marca select */
    .select-wrap select {
        appearance: none;
        -webkit-appearance: none;
        height: 46px;
        padding: 0 42px 0 16px;
        font-size: 0.9rem;
        font-weight: 500;
        border: 1.5px solid var(--line, #d9e2da);
        border-radius: 10px;
        background: #fff;
        color: var(--texto, #1a2e22);
        cursor: pointer;
        outline: none;
        min-width: 170px;
        box-sizing: border-box;
        transition: border-color 150ms, box-shadow 150ms;
    }
    .select-wrap select:focus {
        border-color: var(--green, #257446);
        box-shadow: 0 0 0 3px rgba(37,116,70,.1);
    }
    .select-wrap .select-arrow {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 11px;
        height: 7px;
        color: #7a9985;
        pointer-events: none;
    }

    /* tipo dropdown trigger */
    .dropdown-trigger {
        display: flex;
        align-items: center;
        gap: 8px;
        height: 46px;
        padding: 0 16px;
        font-size: 0.9rem;
        font-weight: 500;
        border: 1.5px solid var(--line, #d9e2da);
        border-radius: 10px;
        background: #fff;
        color: var(--texto, #1a2e22);
        cursor: pointer;
        white-space: nowrap;
        min-width: 190px;
        justify-content: space-between;
        box-sizing: border-box;
        transition: border-color 150ms, box-shadow 150ms;
    }
    .dropdown-trigger:focus,
    .dropdown-trigger[aria-expanded="true"] {
        border-color: var(--green, #257446);
        box-shadow: 0 0 0 3px rgba(37,116,70,.1);
        outline: none;
    }
    .dropdown-trigger .select-arrow { width: 11px; height: 7px; color: #7a9985; flex-shrink: 0; }
    .dropdown-trigger[aria-expanded="true"] .select-arrow { transform: rotate(180deg); }

    /* dropdown panel */
    .dropdown-panel {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        min-width: 100%;
        max-height: 320px;
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1.5px solid var(--line, #d9e2da);
        border-radius: 12px;
        box-shadow: 0 8px 28px rgba(25,67,40,.12);
        z-index: 50;
        overflow: hidden;
    }
    .dropdown-search-wrap {
        padding: 10px 10px 6px;
        border-bottom: 1px solid var(--line, #d9e2da);
    }
    .dropdown-search {
        width: 100%;
        padding: 7px 12px;
        font-size: 0.85rem;
        border: 1.5px solid var(--line, #d9e2da);
        border-radius: 7px;
        outline: none;
        box-sizing: border-box;
        transition: border-color 150ms;
    }
    .dropdown-search:focus { border-color: var(--green, #257446); }
    .dropdown-list {
        list-style: none;
        margin: 0;
        padding: 6px 0;
        overflow-y: auto;
        max-height: 240px;
    }
    .dropdown-item {
        padding: 9px 16px;
        font-size: 0.88rem;
        cursor: pointer;
        color: var(--texto, #1a2e22);
        transition: background 120ms;
    }
    .dropdown-item:hover { background: var(--pale, #f4f8f4); }
    .dropdown-item.active {
        background: rgba(37,116,70,.08);
        color: var(--green, #257446);
        font-weight: 600;
    }

    /* ── results ──────────────────────────────────────── */
    .result-count { margin: 0 0 16px; font-size: 0.84rem; color: #7a9985; font-weight: 500; }
    .search-prompt {
        padding: 48px 0;
        text-align: center;
        color: #9bb5a4;
        font-size: 0.95rem;
    }
    .no-results { padding: 48px 0; text-align: center; color: #7a9985; font-size: 0.95rem; }
    .hidden { display: none !important; }

    /* ── product grid ─────────────────────────────────── */
    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 16px;
    }
    .product-card a {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: #fff;
        border: 1px solid var(--line, #d9e2da);
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        transition: transform 160ms ease, box-shadow 160ms ease;
    }
    .product-card a:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 24px rgba(25,67,40,.11);
    }
    .card-media {
        display: grid;
        place-items: center;
        height: 150px;
        padding: 20px;
        background: radial-gradient(circle at 50% 45%, rgba(64,181,83,.08), transparent 65%), var(--pale, #f4f8f4);
        border-bottom: 1px solid rgba(37,116,70,.08);
    }
    .card-media img { width: 100%; height: 100%; object-fit: contain; }
    .card-brand {
        padding: 10px 14px 0;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--green, #257446);
    }
    .product-card h3 {
        margin: 0;
        padding: 6px 14px 16px;
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1.35;
        color: var(--texto, #1a2e22);
    }

    /* ── brand grid ───────────────────────────────────── */
    .brand-grid { grid-template-columns: repeat(6, 1fr); gap: 18px; }
    .brand-card-logo {
        display: flex;
        min-height: 220px;
        flex-direction: column;
        align-items: flex-start;
        justify-content: space-between;
        padding: 28px 26px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--white);
        box-shadow: var(--shadow);
        overflow: hidden;
    }
    .brand-card-logo:nth-child(1) { grid-column: 1 / span 2; }
    .brand-card-logo:nth-child(2) { grid-column: 3 / span 2; }
    .brand-card-logo:nth-child(3) { grid-column: 5 / span 2; }
    .brand-card-logo:nth-child(4) { grid-column: 2 / span 2; }
    .brand-card-logo:nth-child(5) { grid-column: 4 / span 2; }
    .brand-card-logo img { width: min(100%, 220px); height: 72px; object-fit: contain; object-position: left center; }
    .brand-card-logo p { margin: 18px 0 0; color: #566b60; max-width: 22ch; }
    .arrow {
        color: var(--blue);
        font-weight: 700;
        text-transform: uppercase;
        font-size: .78rem;
        letter-spacing: .06em;
        white-space: nowrap;
    }

    /* ── tipo section ─────────────────────────────────── */
    .tipo-section { background: #fff; border-top: 1px solid var(--line, #d9e2da); }
    .tipo-title { margin: 0 0 32px; font-size: clamp(1.4rem, 3vw, 2rem); color: var(--green, #257446); }
    .tipo-chips { display: flex; flex-wrap: wrap; gap: 10px; }
    .tipo-chip {
        display: inline-block;
        padding: 8px 18px;
        background: var(--pale, #f4f8f4);
        border: 1px solid var(--line, #d9e2da);
        border-radius: 999px;
        font-size: .88rem;
        font-weight: 500;
        color: var(--green, #257446);
        text-decoration: none;
        transition: background 180ms, border-color 180ms, color 180ms;
    }
    .tipo-chip:hover { background: var(--green, #257446); border-color: var(--green, #257446); color: #fff; }

    /* ── mobile ───────────────────────────────────────── */
    @media (max-width: 700px) {
        .controls-row { flex-direction: column; }
        .select-wrap select,
        .dropdown-trigger { min-width: 0; width: 100%; }
        .search-wrap { flex: unset; }
        .brand-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        .brand-card-logo,
        .brand-card-logo:nth-child(n) { grid-column: auto; min-height: 205px; padding: 22px 18px; }
        .brand-card-logo:nth-child(5) { grid-column: 1 / -1; max-width: calc(50% - 7px); width: 100%; justify-self: center; }
        .brand-card-logo img { width: 100%; height: 58px; object-position: center; }
        .brand-card-logo p { font-size: .95rem; line-height: 1.35; margin-top: 14px; }
        .arrow { font-size: .68rem; letter-spacing: .03em; }
        .products-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
        .card-media { height: 120px; }
        .dropdown-panel { position: fixed; top: auto; left: 1rem; right: 1rem; bottom: 1rem; max-height: 60vh; border-radius: 16px; }
    }
</style>
