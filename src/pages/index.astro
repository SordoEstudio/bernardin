---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
import { cms } from "../lib/cms";

interface CMSBtnField { txt_label: string; link_url: string; link_tipo?: string; }
interface HeroData { txt_eyebrow?: string; txt_titulo?: string; txt_texto?: string; btn_cta?: CMSBtnField; }
interface StatsData { lista_stats?: { txt_numero: string; txt_label: string }[]; }
interface StoryData { txt_eyebrow?: string; txt_titulo?: string; txt_descripcion?: string; }
interface MarcasData { txt_eyebrow?: string; txt_h2?: string; txt_descripcion?: string; txt_cta_brands?: string; }
interface NuestraFormaData { txt_eyebrow?: string; txt_h2?: string; txt_descripcion?: string; btn_cta?: CMSBtnField; }

const { components } = await cms.components.list({ page_filter: "Inicio", locale: "es" }).catch(() => ({ components: [] }));
const hero = cms.components.getByType<HeroData>(components, "hero");
const stats = cms.components.getByType<StatsData>(components, "stats");
const story = cms.components.getByType<StoryData>(components, "story_panel");
const marcas = cms.components.getByType<MarcasData>(components, "marcas_section");
const nuestra = cms.components.getByType<NuestraFormaData>(components, "nuestra_forma");
---

<BaseLayout title="Bernardin | Tecnología agrícola" locale="es"
  ><section class="hero">
    <div class="hero-art"></div><div class="container hero-content">
      <span class="eyebrow">{hero?.txt_eyebrow}</span><h1>{hero?.txt_titulo}</h1><p>
        {hero?.txt_texto}
      </p>{hero?.btn_cta && <a class="btn" href={hero.btn_cta.link_url}>{hero.btn_cta.txt_label} <span>→</span></a>}
    </div>
  </section><section class="stats">
    {
      (stats?.lista_stats ?? []).map((s) => (
        <div class="stat container">
          <>
            <strong>{s.txt_numero}</strong>
            <span>{s.txt_label}</span>
          </>
        </div>
      ))
    }
  </section><section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{marcas?.txt_eyebrow}</span><h2>
            {marcas?.txt_h2}
          </h2>
        </div><p>
          {marcas?.txt_descripcion}
        </p>
      </div><div class="brand-grid">
        {
          site.brands.map((b) => (
            <a class="brand-card" href={`/productos/${b.id}`}>
              <>
                <div>
                  <>
                    <div class="brand-mark">{b.name}</div>
                    <p>{b.tag}</p>
                  </>
                </div>
                <span class="arrow">{marcas?.txt_cta_brands}</span>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section><section class="section soft">
    <div class="container split">
      <div>
        <span class="eyebrow">{nuestra?.txt_eyebrow}</span><h2>
          {nuestra?.txt_h2}
        </h2><p>
          {nuestra?.txt_descripcion}
        </p>{nuestra?.btn_cta && <a class="btn alt" href={nuestra.btn_cta.link_url}>{nuestra.btn_cta.txt_label}</a>}
      </div><div class="story-panel">
        <span class="eyebrow">{story?.txt_eyebrow}</span><h2>
          {story?.txt_titulo}
        </h2><p>
          {story?.txt_descripcion}
        </p>
      </div>
    </div>
  </section></BaseLayout
><style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    background: var(--white);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stats .stat {
    width: 100%;
    min-height: 142px;
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--pale);
    color: var(--green);
    border-right: 1px solid var(--line);
  }
  .stats .stat:last-child {
    border-right: 0;
  }
  .stats .stat strong {
    font-size: clamp(2.1rem, 4vw, 3.5rem);
    line-height: 1;
    color: var(--green);
  }
  .stats .stat span {
    max-width: 16ch;
    margin-top: 10px;
    color: var(--ink);
    font-size: 0.92rem;
  }
  .stats .stat:nth-child(2),
  .stats .stat:nth-child(3),
  .stats .stat:nth-child(4) {
    background: var(--pale);
    color: var(--green);
  }
  .stats .stat:nth-child(2) strong,
  .stats .stat:nth-child(3) strong,
  .stats .stat:nth-child(4) strong {
    color: var(--green);
  }
  .stats .stat:nth-child(2) span,
  .stats .stat:nth-child(3) span,
  .stats .stat:nth-child(4) span {
    color: var(--ink);
  }
  .story-panel {
    background: var(--green);
    color: white;
    padding: clamp(28px, 5vw, 64px);
    border-radius: 4px;
  }
  .story-panel .eyebrow {
    color: #b9efc3;
  }
  .story-panel h2 {
    color: white;
  }
  .story-panel p {
    color: #f1fff4;
  }
  @media (max-width: 700px) {
    .stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      background: var(--line);
      padding: 0;
    }
    .stats .stat {
      width: 100%;
      min-height: 126px;
      padding: 22px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: var(--white);
    }
    .stats .stat strong {
      font-size: 2.25rem;
      line-height: 1;
    }
    .stats .stat span {
      max-width: 13ch;
      margin-top: 8px;
      font-size: 0.82rem;
      line-height: 1.25;
    }
    .story-panel {
      margin-top: 28px;
      padding: 30px 24px;
      min-height: 300px;
      background: linear-gradient(145deg, #e9f4e9 0%, #d4eadb 100%);
      border: 1px solid #b8d7c1;
      border-radius: 8px;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .story-panel .eyebrow {
      color: var(--green);
    }
    .story-panel h2 {
      color: var(--green);
      font-size: 2rem;
    }
    .story-panel p {
      color: var(--ink);
      margin-bottom: 0;
    }
  }
</style>
