---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
import { cms } from "../lib/cms";
import { BRAND_CATEGORY_ID, getProductImageUrl } from "../lib/products-utils";
import type { Product, NewsItem } from "../lib/cms/types";

interface CMSBtnField { txt_label: string; link_url: string; link_tipo?: string; }
interface HeroData { txt_eyebrow?: string; txt_titulo?: string; txt_texto?: string; btn_cta?: CMSBtnField; }
interface StatsData { lista_stats?: { txt_numero: string; txt_label: string }[]; }
interface StoryData { txt_eyebrow?: string; txt_titulo?: string; txt_descripcion?: string; }
interface MarcasData { txt_eyebrow?: string; txt_h2?: string; txt_descripcion?: string; txt_cta_brands?: string; }
interface NuestraFormaData { txt_eyebrow?: string; txt_h2?: string; txt_descripcion?: string; btn_cta?: CMSBtnField; }

const [{ components }, { items: latestNews }, enrichedFeatured] = await Promise.all([
    cms.components.list({ page_filter: "Inicio", locale: "es" }).catch(() => ({ components: [] })),
    cms.news.list({ limit: 3 }).catch(() => ({ items: [] as NewsItem[] })),
    Promise.all(
        site.brands
            .filter(b => BRAND_CATEGORY_ID[b.id])
            .map(b =>
                cms.products.list({ locale: "es", category: BRAND_CATEGORY_ID[b.id], limit: 2 })
                    .then(({ products }) => products.map((p: Product) => ({ product: p, brandId: b.id, brand: b })))
                    .catch(() => [] as Array<{ product: Product; brandId: string; brand: (typeof site.brands)[number] }>)
            )
    ).then(batches => batches.flat().slice(0, 8)),
]);
const hero = cms.components.getByType<HeroData>(components, "hero");
const stats = cms.components.getByType<StatsData>(components, "stats");
const story = cms.components.getByType<StoryData>(components, "story_panel");
const marcas = cms.components.getByType<MarcasData>(components, "marcas_section");
const nuestra = cms.components.getByType<NuestraFormaData>(components, "nuestra_forma");
const fmtDate = (item: NewsItem) => new Date(item.publishedAt ?? item.createdAt).toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric" });
---

<BaseLayout title="Bernardin | Tecnología agrícola" locale="es"
  ><section class="hero">
    <div class="hero-art"></div><div class="container hero-content">
      <span class="eyebrow">{hero?.txt_eyebrow}</span><h1>{hero?.txt_titulo}</h1><p>
        {hero?.txt_texto}
      </p>{hero?.btn_cta && <a class="btn" href={hero.btn_cta.link_url}>{hero.btn_cta.txt_label} <span>→</span></a>}
    </div>
  </section><section class="stats">
    {
      (stats?.lista_stats ?? []).map((s) => (
        <div class="stat container">
          <>
            <strong>{s.txt_numero}</strong>
            <span>{s.txt_label}</span>
          </>
        </div>
      ))
    }
  </section><section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">{marcas?.txt_eyebrow}</span><h2>
            {marcas?.txt_h2}
          </h2>
        </div><p>
          {marcas?.txt_descripcion}
        </p>
      </div><div class="brand-grid">
        {
          site.brands.map((b) => (
            <a class="brand-card" href={`/productos/${b.id}`}>
              <img class="brand-logo-card" src={b.logo} alt={b.name} loading="lazy" />
              <p>{b.tag}</p>
              <span class="arrow">{marcas?.txt_cta_brands}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section><section class="section soft">
    <div class="container split">
      <div>
        <span class="eyebrow">{nuestra?.txt_eyebrow}</span><h2>
          {nuestra?.txt_h2}
        </h2><p>
          {nuestra?.txt_descripcion}
        </p>{nuestra?.btn_cta && <a class="btn alt" href={nuestra.btn_cta.link_url}>{nuestra.btn_cta.txt_label}</a>}
      </div><div class="story-panel">
        <span class="eyebrow">{story?.txt_eyebrow}</span><h2>
          {story?.txt_titulo}
        </h2><p>
          {story?.txt_descripcion}
        </p>
      </div>
    </div>
  </section>
  {enrichedFeatured.length > 0 && (
  <section class="section products-home">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Maquinaria</span>
          <h2>Nuestros productos</h2>
        </div>
        <a href="/productos" class="btn">Ver todos <span>→</span></a>
      </div>
      <div class="products-home-grid">
        {enrichedFeatured.map(({ product, brandId, brand }) => (
          <a class="product-home-card" href={`/productos/${brandId}/${product.slug}`}>
            <div class="phc-media">
              <img src={getProductImageUrl(product, brand.logo)} alt={product.locale?.title ?? product.slug} loading="lazy" />
            </div>
            <span class="phc-brand">{brand.name}</span>
            <span class="phc-name">{product.locale?.title ?? product.slug}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  )}
  {latestNews.length > 0 && (
  <section class="section soft news-home">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Novedades</span>
          <h2>Últimas noticias</h2>
        </div>
        <a href="/noticias" class="btn">Ver todas <span>→</span></a>
      </div>
      <div class="news-home-grid">
        {latestNews.map((article) => (
          <a class="news-home-card" href={`/noticias/${article.slug}`}>
            <span class="nhc-date">{fmtDate(article)}</span>
            <h3>{article.title}</h3>
            {article.summary && <p>{article.summary}</p>}
          </a>
        ))}
      </div>
    </div>
  </section>
  )}
</BaseLayout>
<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    background: var(--white);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stats .stat {
    width: 100%;
    min-height: 142px;
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--pale);
    color: var(--green);
    border-right: 1px solid var(--line);
  }
  .stats .stat:last-child {
    border-right: 0;
  }
  .stats .stat strong {
    font-size: clamp(2.1rem, 4vw, 3.5rem);
    line-height: 1;
    color: var(--green);
  }
  .stats .stat span {
    max-width: 16ch;
    margin-top: 10px;
    color: var(--ink);
    font-size: 0.92rem;
  }
  .stats .stat:nth-child(2),
  .stats .stat:nth-child(3),
  .stats .stat:nth-child(4) {
    background: var(--pale);
    color: var(--green);
  }
  .stats .stat:nth-child(2) strong,
  .stats .stat:nth-child(3) strong,
  .stats .stat:nth-child(4) strong {
    color: var(--green);
  }
  .stats .stat:nth-child(2) span,
  .stats .stat:nth-child(3) span,
  .stats .stat:nth-child(4) span {
    color: var(--ink);
  }
  .story-panel {
    background: var(--green);
    color: white;
    padding: clamp(28px, 5vw, 64px);
    border-radius: 4px;
  }
  .story-panel .eyebrow {
    color: #b9efc3;
  }
  .story-panel h2 {
    color: white;
  }
  .story-panel p {
    color: #f1fff4;
  }
  @media (max-width: 700px) {
    .stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      background: var(--line);
      padding: 0;
    }
    .stats .stat {
      width: 100%;
      min-height: 126px;
      padding: 22px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: var(--white);
    }
    .stats .stat strong {
      font-size: 2.25rem;
      line-height: 1;
    }
    .stats .stat span {
      max-width: 13ch;
      margin-top: 8px;
      font-size: 0.82rem;
      line-height: 1.25;
    }
    .story-panel {
      margin-top: 28px;
      padding: 30px 24px;
      min-height: 300px;
      background: linear-gradient(145deg, #e9f4e9 0%, #d4eadb 100%);
      border: 1px solid #b8d7c1;
      border-radius: 8px;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .story-panel .eyebrow {
      color: var(--green);
    }
    .story-panel h2 {
      color: var(--green);
      font-size: 2rem;
    }
    .story-panel p {
      color: var(--ink);
      margin-bottom: 0;
    }
  }
  /* ── brand logos ── */
  .brand-logo-card {
    height: 44px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    object-position: left center;
  }
  /* ── products preview ── */
  .products-home-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .product-home-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 160ms, box-shadow 160ms;
  }
  .product-home-card:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(25,67,40,.11); }
  .phc-media {
    display: grid;
    place-items: center;
    height: 150px;
    padding: 20px;
    background: radial-gradient(circle at 50% 45%, rgba(64,181,83,.08), transparent 65%), var(--pale);
    border-bottom: 1px solid rgba(37,116,70,.08);
  }
  .phc-media img { width: 100%; height: 100%; object-fit: contain; max-height: 110px; }
  .phc-brand {
    padding: 10px 14px 0;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--green);
  }
  .phc-name {
    padding: 4px 14px 16px;
    font-size: .9rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
  }
  /* ── news preview ── */
  .news-home-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .news-home-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    transition: transform 160ms, box-shadow 160ms;
    gap: 8px;
  }
  .news-home-card:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(25,67,40,.11); }
  .nhc-date { font-size: .78rem; color: var(--blue); font-weight: 700; letter-spacing: .04em; }
  .news-home-card h3 { margin: 0; font-size: 1.05rem; color: var(--green); line-height: 1.3; font-family: var(--display); }
  .news-home-card p { margin: 0; font-size: .88rem; color: #587064; line-height: 1.6; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
  @media (max-width: 800px) {
    .products-home-grid { grid-template-columns: repeat(2, 1fr); }
    .news-home-grid { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
