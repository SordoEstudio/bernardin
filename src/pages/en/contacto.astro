---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cms } from "../../lib/cms";

interface CMSContactItem { icon_contacto?: string; txt_label: string; link_destino: string; txt_valor?: string; }
interface ContactoInfoData {
  txt_h1?: string;
  txt_eyebrow?: string;
  txt_h2?: string;
  txt_descripcion?: string;
  txt_btn_submit?: string;
  lista_contacto?: CMSContactItem[];
}

const { components } = await cms.components.list({ page_filter: "Contacto", locale: "en" }).catch(() => ({ components: [] }));
const contactoInfo = cms.components.getByType<ContactoInfoData>(components, "contacto_info");
const contactLinks = contactoInfo?.lista_contacto ?? [];
---

<BaseLayout locale="en" title="Contact | Bernardin">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumbs"><a href="/en">Home</a> / Contact</div>
      <h1>{contactoInfo?.txt_h1}</h1>
    </div>
  </section>
  <section class="section">
    <div class="container contact-grid">
      <div>
        <span class="eyebrow">{contactoInfo?.txt_eyebrow}</span>
        <h2>{contactoInfo?.txt_h2}</h2>
        <p>{contactoInfo?.txt_descripcion}</p>
        {contactLinks.map((c) => (
          <div class="contact-card">
            <strong>{c.txt_label}</strong>
            <a href={c.link_destino}>{c.txt_valor ?? c.link_destino} →</a>
          </div>
        ))}
      </div>
      <form id="contact-form" class="form contact-card">
        <div class="form-field">
          <label for="nombre">Name</label>
          <input id="nombre" required name="nombre" placeholder="Your name" />
        </div>
        <div class="form-field">
          <label for="email">Email</label>
          <input id="email" required type="email" name="email" placeholder="you@email.com" />
        </div>
        <div class="form-field">
          <label for="mensaje">Message</label>
          <textarea id="mensaje" required name="mensaje" placeholder="How can we help?"></textarea>
        </div>
        <button class="btn" type="submit">{contactoInfo?.txt_btn_submit ?? 'Send inquiry →'}</button>
      </form>
    </div>
  </section>
  <style>
    .contact-card {
      width: 100%;
      max-width: 820px;
      margin-inline: auto;
      padding: clamp(24px, 4vw, 42px);
    }
    .form.contact-card {
      max-width: 820px;
    }
    .contact-card label {
      display: block;
      margin: 0 0 8px;
      font: 700 0.78rem var(--display);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--green);
    }
    .contact-card input,
    .contact-card textarea {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 3px;
      padding: 13px 15px;
      background: #fff;
      color: var(--ink);
      margin-bottom: 18px;
    }
    .contact-card textarea {
      min-height: 150px;
      resize: vertical;
    }
    .contact-card .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 20px;
    }
    .contact-card .form-grid .full {
      grid-column: 1/-1;
    }
    @media (max-width: 640px) {
      .contact-card .form-grid {
        grid-template-columns: 1fr;
      }
      .contact-card .form-grid .full {
        grid-column: auto;
      }
    }
  </style>
  <script is:inline define:vars={{ endpoint: `${import.meta.env.PUBLIC_CMS_API}/forms/contacto/submit` }}>
    document.getElementById('contact-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.currentTarget.querySelector('[type="submit"]');
      btn.disabled = true;
      const body = Object.fromEntries(new FormData(e.currentTarget));
      try {
        const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        const json = await res.json();
        if (json.success) {
          e.currentTarget.innerHTML = `<p style="color:var(--green);padding:24px">${json.data?.message ?? 'Message sent!'}</p>`;
        } else { btn.disabled = false; alert('Error sending. Please try again.'); }
      } catch { btn.disabled = false; alert('Connection error. Please try again.'); }
    });
  </script>
</BaseLayout>
