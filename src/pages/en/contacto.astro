---
import BaseLayout from '../../layouts/BaseLayout.astro'; import site from '../../data/site.json'
---
<BaseLayout locale="en" title="Contact | Alfaterra"><section class="page-hero"><div class="container"><div class="breadcrumbs">Home / Contact</div><h1>Let's talk about your next challenge.</h1></div></section><section class="section"><div class="container contact-grid"><div><span class="eyebrow">Direct contact</span><h2>We are here to help.</h2><p>Tell us what you are looking for and our team will get in touch.</p><div class="contact-card info-card"><strong>WhatsApp</strong><a href={`https://wa.me/${site.contact.whatsapp}`}>+54 9 3492 597277 →</a></div><div class="contact-card info-card"><strong>Email</strong><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></div></div><form class="form contact-card"><div class="form-grid"><div class="form-field"><label for="name">Name</label><input id="name" required name="name" placeholder="Your name" /></div><div class="form-field"><label for="email">Email</label><input id="email" required type="email" name="email" placeholder="you@email.com" /></div><div class="form-field full"><label for="message">Message</label><textarea id="message" required name="message" placeholder="How can we help?"></textarea></div></div><button class="btn" type="submit">Send inquiry →</button></form></div></section><style>.contact-grid{align-items:start}.contact-card{width:100%;max-width:820px;margin-inline:auto;padding:clamp(24px,4vw,42px)}.form.contact-card{max-width:820px}.contact-card label{display:block;margin:0 0 8px;font:700 .78rem var(--display);letter-spacing:.08em;text-transform:uppercase;color:var(--green)}.contact-card input,.contact-card textarea{width:100%;border:1px solid var(--line);border-radius:3px;padding:13px 15px;background:#fff;color:var(--ink);margin-bottom:18px}.contact-card textarea{min-height:150px;resize:vertical}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 20px}.form-grid .full{grid-column:1/-1}@media(max-width:640px){.form-grid{grid-template-columns:1fr}.form-grid .full{grid-column:auto}}</style></BaseLayout>
