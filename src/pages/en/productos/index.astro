---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import site from "../../../data/site.json";
import { cms } from "../../../lib/cms";
import { getTypeNamesForProduct, slugifyType } from "../../../lib/products-utils";

interface ProductosHeaderData { txt_h1?: string; txt_descripcion?: string; txt_ver_productos?: string; }

const [{ components }, { products: allProducts }] = await Promise.all([
    cms.components.list({ page_filter: "Productos", locale: "en" }).catch(() => ({ components: [] })),
    cms.products.list({ locale: "en", limit: 200 }).catch(() => ({ products: [] })),
]);
const productosHeader = cms.components.getByType<ProductosHeaderData>(components, "productos_header");
const typeNames = [...new Set(allProducts.flatMap((p) => getTypeNamesForProduct(p)))].sort((a, b) => a.localeCompare(b, "en"));
---

<BaseLayout locale="en" title="Products | Bernardin"
    ><section class="page-hero">
        <div class="container">
            <div class="breadcrumbs">Home / Products</div><h1>
                {productosHeader?.txt_h1}
            </h1><p>
                {productosHeader?.txt_descripcion}
            </p>
        </div>
    </section><section class="section">
        <div class="container">
            <div class="brand-grid">
                {
                    site.brands.map((b) => (
                        <a
                            class="brand-card brand-card-logo"
                            href={`/en/productos/${b.id}`}
                        >
                            <>
                                <img src={b.logo} alt={`${b.name} logo`} />
                                <p>{b.tagEn}</p>
                                <span class="arrow">{productosHeader?.txt_ver_productos}</span>
                            </>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>
    <section class="section tipo-section">
        <div class="container">
            <h2 class="tipo-title">Browse by type</h2>
            <div class="tipo-chips">
                {
                    typeNames.map((name) => (
                        <a class="tipo-chip" href={`/en/productos/tipo/${slugifyType(name)}`}>
                            {name}
                        </a>
                    ))
                }
            </div>
        </div>
    </section></BaseLayout
><style>
    .brand-grid {
        grid-template-columns: repeat(6, 1fr);
        gap: 18px;
    }
    .brand-card-logo {
        display: flex;
        min-height: 220px;
        flex-direction: column;
        align-items: flex-start;
        justify-content: space-between;
        padding: 28px 26px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--white);
        box-shadow: var(--shadow);
        overflow: hidden;
    }
    .brand-card-logo:nth-child(1) {
        grid-column: 1 / span 2;
    }
    .brand-card-logo:nth-child(2) {
        grid-column: 3 / span 2;
    }
    .brand-card-logo:nth-child(3) {
        grid-column: 5 / span 2;
    }
    .brand-card-logo:nth-child(4) {
        grid-column: 2 / span 2;
    }
    .brand-card-logo:nth-child(5) {
        grid-column: 4 / span 2;
    }
    .brand-card-logo img {
        width: min(100%, 220px);
        height: 72px;
        object-fit: contain;
        object-position: left center;
    }
    .brand-card-logo p {
        margin: 18px 0 0;
        color: #566b60;
        max-width: 22ch;
    }
    .arrow {
        color: var(--blue);
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.78rem;
        letter-spacing: 0.06em;
        white-space: nowrap;
    }
    .tipo-section {
        background: var(--pale, #f4f8f4);
        border-top: 1px solid var(--line, #d9e2da);
    }
    .tipo-title {
        margin: 0 0 32px;
        font-size: clamp(1.4rem, 3vw, 2rem);
        color: var(--green, #257446);
    }
    .tipo-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
    .tipo-chip {
        display: inline-block;
        padding: 8px 18px;
        background: #fff;
        border: 1px solid var(--line, #d9e2da);
        border-radius: 999px;
        font-size: 0.88rem;
        font-weight: 500;
        color: var(--green, #257446);
        text-decoration: none;
        transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
    }
    .tipo-chip:hover {
        background: var(--green, #257446);
        border-color: var(--green, #257446);
        color: #fff;
    }
    @media (max-width: 700px) {
        .section {
            padding: 64px 0;
        }
        .brand-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }
        .brand-card-logo,
        .brand-card-logo:nth-child(n) {
            grid-column: auto;
            min-height: 205px;
            padding: 22px 18px;
        }
        .brand-card-logo:nth-child(5) {
            grid-column: 1 / -1;
            max-width: calc(50% - 7px);
            width: 100%;
            justify-self: center;
        }
        .brand-card-logo img {
            width: 100%;
            height: 58px;
            object-position: center;
        }
        .brand-card-logo p {
            font-size: 0.95rem;
            line-height: 1.35;
            margin-top: 14px;
        }
        .arrow {
            font-size: 0.68rem;
            letter-spacing: 0.03em;
        }
    }
</style>
