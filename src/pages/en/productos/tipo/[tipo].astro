---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import site from "../../../../data/site.json";
import { cms } from "../../../../lib/cms";
import { getTypeNamesForProduct, getBrandIdForProduct, slugifyType } from "../../../../lib/products-utils";

export async function getStaticPaths() {
    try {
        const { products } = await cms.products.list({ locale: "en", limit: 200 });
        const typeMap = new Map<string, string>();
        for (const p of products) {
            for (const name of getTypeNamesForProduct(p)) {
                typeMap.set(slugifyType(name), name);
            }
        }
        return [...typeMap.entries()].map(([tipo, typeName]) => ({
            params: { tipo },
            props: { typeName },
        }));
    } catch {
        return [];
    }
}

const { typeName } = Astro.props as { typeName: string };
const { products: allProducts } = await cms.products.list({ locale: "en", limit: 200 }).catch(() => ({ products: [] }));
const products = allProducts.filter((p) => getTypeNamesForProduct(p).includes(typeName));
const allCategories = await cms.categories.list().catch(() => []);
const typeCategory = allCategories.find((c) => c.name === typeName);
---

<BaseLayout locale="en" title={`${typeName} | Products | Bernardin`}>
    <section class="page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/en/productos">Products</a> / {typeName}
            </div>
            <h1>{typeName}</h1>
            {typeCategory?.description && <p>{typeCategory.description}</p>}
        </div>
    </section>
    <section class="section">
        <div class="container">
            <div class="tipo-brand-nav">
                {
                    site.brands.map((b) => (
                        <a href={`/en/productos/${b.id}`}>
                            <img src={b.logo} alt={b.name} />
                        </a>
                    ))
                }
            </div>
            <div class="items">
                {
                    products.map((p) => {
                        const brandId = getBrandIdForProduct(p);
                        const brand = site.brands.find((b) => b.id === brandId);
                        return (
                            <article class="product-card">
                                <div class="product-media">
                                    <img
                                        src={p.images?.[0] ?? brand?.logo ?? ""}
                                        alt={p.locale?.title ?? p.slug}
                                    />
                                </div>
                                {brand && (
                                    <span class="brand-label">{brand.name}</span>
                                )}
                                <h3>
                                    {brandId ? (
                                        <a href={`/en/productos/${brandId}/${p.slug}`}>
                                            {p.locale?.title ?? p.slug}
                                        </a>
                                    ) : (
                                        p.locale?.title ?? p.slug
                                    )}
                                </h3>
                            </article>
                        );
                    })
                }
            </div>
            {products.length === 0 && <p class="empty">No products available.</p>}
        </div>
    </section>
</BaseLayout>
<style>
    .tipo-brand-nav {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 48px;
    }
    .tipo-brand-nav a {
        display: grid;
        place-items: center;
        padding: 10px 16px;
        background: var(--pale, #f4f8f4);
        border: 1px solid var(--line, #d9e2da);
        border-radius: 10px;
        transition: border-color 180ms ease, transform 180ms ease;
    }
    .tipo-brand-nav a:hover {
        border-color: var(--green, #257446);
        transform: translateY(-2px);
    }
    .tipo-brand-nav img {
        width: 110px;
        height: 32px;
        object-fit: contain;
    }
    .items {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 22px;
    }
    .product-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--line, #d9e2da);
        border-radius: 14px;
        box-shadow: 0 5px 16px rgba(25, 67, 40, 0.06);
        transition: transform 180ms ease, box-shadow 180ms ease;
    }
    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 30px rgba(25, 67, 40, 0.13);
    }
    .product-media {
        display: grid;
        place-items: center;
        min-height: 180px;
        padding: 28px;
        background: radial-gradient(circle at 50% 45%, rgba(64, 181, 83, 0.09), transparent 65%), var(--pale, #f4f8f4);
        border-bottom: 1px solid rgba(37, 116, 70, 0.1);
    }
    .product-media img {
        width: 100%;
        height: 120px;
        object-fit: contain;
    }
    .brand-label {
        padding: 10px 18px 0;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--green, #257446);
    }
    .product-card h3 {
        margin: 0;
        padding: 8px 18px 20px;
        color: var(--green, #257446);
        font-size: 1rem;
        line-height: 1.35;
    }
    .product-card h3 a {
        color: inherit;
        text-decoration: none;
    }
    .product-card h3 a:hover {
        text-decoration: underline;
    }
    .empty {
        color: var(--texto-suave, #5b675e);
        margin-top: 32px;
    }
    @media (max-width: 600px) {
        .items {
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }
        .product-media {
            min-height: 140px;
            padding: 20px;
        }
        .product-media img {
            height: 90px;
        }
    }
</style>
