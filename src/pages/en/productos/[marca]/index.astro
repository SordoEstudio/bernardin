---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import site from "../../../../data/site.json";
import { cms } from "../../../../lib/cms";
import type { Product, Category } from "../../../../lib/cms/types";
import { BRAND_CATEGORY_ID, getTypeNamesForProduct, slugifyType } from "../../../../lib/products-utils";

export async function getStaticPaths() {
    const [brandsData, allCategories] = await Promise.all([
        Promise.all(
            site.brands
                .filter((b) => BRAND_CATEGORY_ID[b.id])
                .map((b) =>
                    cms.products
                        .list({ locale: "en", category: BRAND_CATEGORY_ID[b.id], limit: 500 })
                        .then(({ products }) => ({ brandId: b.id, products }))
                        .catch(() => ({ brandId: b.id, products: [] as Product[] })),
                ),
        ),
        cms.categories.list().catch(() => [] as Category[]),
    ]);
    const brandProductMap = new Map(brandsData.map(({ brandId, products }) => [brandId, products]));
    return site.brands.map((b) => ({
        params: { marca: b.id },
        props: { brand: b, products: brandProductMap.get(b.id) ?? [], allCategories },
    }));
}

const { brand, products, allCategories } = Astro.props as {
    brand: (typeof site.brands)[number];
    products: Product[];
    allCategories: Category[];
};
const uniqueTypes = [...new Set(products.flatMap((p) => getTypeNamesForProduct(p)))];
const getCat = (name: string): Category | undefined =>
    allCategories.find((c) => c.name === name);
---

<BaseLayout locale="en" title={`${brand.name} | Bernardin`}>
    <section class="page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/en/productos">Products</a> / {brand.name}
            </div>
            <img
                class="brand-logo-hero"
                src={brand.logo}
                alt={`Logo of ${brand.name}`}
            />
            <p>{brand.tagEn}</p>
            <div class="brand-strip" aria-label="Bernardin brands">
                {
                    site.brands.map((b) => (
                        <a
                            class:list={{ active: b.id === brand.id }}
                            href={`/en/productos/${b.id}`}
                        >
                            <img src={b.logo} alt={b.name} />
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <div class="search-bar-outer">
        <div class="container">
            <div class="search-ctrl">
                <svg class="search-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6"/>
                    <path d="M13 13l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
                <input id="brand-search" type="search" placeholder={`Search in ${brand.name}...`} autocomplete="off" />
            </div>
        </div>
    </div>

    <section class="section">
        <div class="container">
            {uniqueTypes.length > 1 && (
                <div class="type-chips-wrap">
                    <div class="type-chips" id="type-chips">
                        {uniqueTypes.map((typeName, i) => (
                            <a
                                class:list={["type-chip", { "type-chip-extra": i >= 4 }]}
                                href={`#${slugifyType(typeName)}`}
                            >{typeName}</a>
                        ))}
                    </div>
                    {uniqueTypes.length > 4 && (
                        <button
                            class="type-chips-toggle"
                            id="type-chips-toggle"
                            type="button"
                            data-total={uniqueTypes.length}
                            data-label-more="See all types"
                            data-label-less="Hide"
                        >
                            See all types ({uniqueTypes.length}) ↓
                        </button>
                    )}
                </div>
            )}

            <div class="products-column">
                {
                    uniqueTypes.map((typeName) => {
                        const cat = getCat(typeName);
                        const items = products.filter((p) =>
                            getTypeNamesForProduct(p).includes(typeName),
                        );
                        return (
                            <article class="category" id={slugifyType(typeName)}>
                                <header>
                                    <div>
                                        <span class="eyebrow">{brand.name}</span>
                                        <h2>{typeName}</h2>
                                    </div>
                                </header>
                                <p>{cat?.description ?? ""}</p>
                                <div class="items">
                                    {items.map((p) => (
                                        <article class="product-card" data-nombre={(p.locale?.title ?? p.slug).toLowerCase()}>
                                            <div class="product-media">
                                                <img
                                                    src={p.images?.[0] ?? brand.logo}
                                                    alt={p.locale?.title ?? p.slug}
                                                />
                                            </div>
                                            <h3>
                                                <a
                                                    href={`/en/productos/${brand.id}/${p.slug}`}
                                                >
                                                    {p.locale?.title ?? p.slug}
                                                </a>
                                            </h3>
                                        </article>
                                    ))}
                                </div>
                            </article>
                        );
                    })
                }
            </div>
        </div>
    </section>
</BaseLayout>

<script is:inline>
(function () {
    /* ── type chips toggle ── */
    var toggle = document.getElementById("type-chips-toggle");
    if (toggle) {
        var chips = document.getElementById("type-chips");
        var total = toggle.dataset.total;
        var labelMore = toggle.dataset.labelMore;
        var labelLess = toggle.dataset.labelLess;
        toggle.addEventListener("click", function () {
            var expanded = chips.classList.toggle("expanded");
            toggle.textContent = expanded ? labelLess + " ↑" : labelMore + " (" + total + ") ↓";
        });
    }

    /* ── brand search ── */
    var searchInput = document.getElementById("brand-search");
    var cards       = document.querySelectorAll(".product-card");
    var categories  = document.querySelectorAll("article.category");

    searchInput.addEventListener("input", function () {
        var q = searchInput.value.toLowerCase().trim();
        if (!q) {
            cards.forEach(function (c) { c.classList.remove("hidden"); });
            categories.forEach(function (c) { c.classList.remove("hidden"); });
            return;
        }
        cards.forEach(function (card) {
            card.classList.toggle("hidden", !(card.dataset.nombre || "").includes(q));
        });
        categories.forEach(function (cat) {
            var hasVisible = cat.querySelectorAll(".product-card:not(.hidden)").length > 0;
            cat.classList.toggle("hidden", !hasVisible);
        });
    });
})();
</script>

<style>
    .hidden { display: none !important; }

    .search-bar-outer {
        background: var(--pale, #f4f8f4);
        border-top: 1px solid var(--line, #d9e2da);
        border-bottom: 1px solid var(--line, #d9e2da);
        padding: 14px 0;
    }
    .search-ctrl {
        position: relative;
        display: flex;
        align-items: center;
        max-width: 480px;
    }
    .search-icon {
        position: absolute;
        left: 12px;
        width: 16px; height: 16px;
        color: #8aab96;
        pointer-events: none;
    }
    #brand-search {
        width: 100%;
        height: 42px;
        padding: 0 14px 0 36px;
        border: 1.5px solid var(--line, #d9e2da);
        border-radius: 9px;
        background: #fff;
        font-size: .88rem;
        color: var(--texto, #1a2e22);
        outline: none;
        box-sizing: border-box;
        transition: border-color 140ms, box-shadow 140ms;
        font-family: inherit;
    }
    #brand-search:focus {
        border-color: var(--green, #257446);
        box-shadow: 0 0 0 3px rgba(37,116,70,.1);
    }
    #brand-search::placeholder { color: #9bb5a4; }

    .brand-logo-hero {
        width: 210px;
        height: 60px;
        object-fit: contain;
        object-position: left;
        margin: 24px 0 18px;
    }

    .brand-strip {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
        margin: 24px 0 0;
    }

    .brand-strip a {
        display: grid;
        place-items: center;
        padding: 8px 14px;
        background: rgba(255,255,255,.18);
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 10px;
        transition:
            transform 180ms ease,
            border-color 180ms ease,
            background 180ms ease,
            box-shadow 180ms ease;
    }

    .brand-strip a:hover,
    .brand-strip a:focus-visible {
        transform: translateY(-2px);
        background: rgba(255,255,255,.32);
        border-color: rgba(255,255,255,.7);
        box-shadow: 0 6px 16px rgba(25, 67, 40, 0.1);
    }

    .brand-strip a.active {
        border: 2px solid #fff;
        background: #fff;
        box-shadow: 0 6px 16px rgba(25, 67, 40, 0.14);
    }

    .brand-strip img {
        width: 100px;
        height: 28px;
        object-fit: contain;
    }

    .products-column {
        max-width: 980px;
        margin: 0 auto;
    }

    .category {
        margin-bottom: 42px;
        padding: clamp(28px, 4vw, 48px);
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid var(--line, #d9e2da);
        border-radius: 20px;
        box-shadow: 0 12px 30px rgba(25, 67, 40, 0.06);
    }

    .category header {
        padding-bottom: 18px;
        border-bottom: 1px solid rgba(37, 116, 70, 0.14);
    }

    .category h2 {
        margin: 8px 0 0;
        color: var(--green, #257446);
        font-size: clamp(1.7rem, 4vw, 3rem);
        line-height: 1.08;
        overflow-wrap: anywhere;
    }

    .category > p {
        max-width: 680px;
        margin: 22px 0 0;
        color: var(--texto-suave, #5b675e);
        line-height: 1.7;
    }

    .items {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
        margin-top: 30px;
    }

    .product-card {
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-width: 0;
        background: #fff;
        border: 1px solid var(--line, #d9e2da);
        border-radius: 14px;
        box-shadow: 0 5px 16px rgba(25, 67, 40, 0.06);
        transition:
            transform 180ms ease,
            box-shadow 180ms ease,
            border-color 180ms ease;
    }

    .product-card::before {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 3px;
        background: var(--green, #257446);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 180ms ease;
        z-index: 2;
    }

    .product-card:hover {
        transform: translateY(-5px);
        border-color: rgba(37, 116, 70, 0.35);
        box-shadow: 0 16px 30px rgba(25, 67, 40, 0.13);
    }

    .product-card:hover::before {
        transform: scaleX(1);
    }

    .product-media {
        display: grid;
        place-items: center;
        min-height: 210px;
        padding: 32px;
        background:
            radial-gradient(
                circle at 50% 45%,
                rgba(64, 181, 83, 0.1),
                transparent 66%
            ),
            var(--pale, #f4f8f4);
        border-bottom: 1px solid rgba(37, 116, 70, 0.1);
    }

    .product-media img {
        width: 100%;
        height: 150px;
        object-fit: contain;
        transition: transform 300ms ease;
    }

    .product-card:hover .product-media img {
        transform: scale(1.045);
    }

    .product-card h3 {
        margin: 0;
        padding: 20px 24px 22px;
        color: var(--green, #257446);
        font-family: var(--fuente-display);
        font-size: var(--text-lg, 1.15rem);
        font-weight: var(--peso-bold, 700);
        line-height: 1.3;
    }

    @media (max-width: 700px) {
        .brand-strip {
            margin-bottom: 38px;
        }
        .brand-strip a {
            min-width: 132px;
        }
        .category {
            padding: 24px 18px;
            border-radius: 16px;
        }
        .items {
            grid-template-columns: 1fr;
            gap: 18px;
        }
        .product-media {
            min-height: 190px;
            padding: 26px;
        }
        .product-media img {
            height: 140px;
        }
        .product-card h3 {
            padding: 18px 20px 20px;
        }
    }

    .type-chips-wrap {
        max-width: 980px;
        margin: 0 auto 40px;
    }
    .type-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
    .type-chip {
        display: inline-block;
        padding: 8px 18px;
        background: var(--pale, #f4f8f4);
        border: 1px solid var(--line, #d9e2da);
        border-radius: 999px;
        font-size: .88rem;
        font-weight: 500;
        color: var(--green, #257446);
        text-decoration: none;
        transition: background 180ms, border-color 180ms, color 180ms;
    }
    .type-chip:hover {
        background: var(--green, #257446);
        border-color: var(--green, #257446);
        color: #fff;
    }
    .type-chip-extra { display: none; }
    .type-chips.expanded .type-chip-extra { display: inline-block; }
    .type-chips-toggle {
        margin-top: 10px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        background: none;
        border: 1.5px dashed var(--line, #d9e2da);
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 600;
        color: var(--green, #257446);
        cursor: pointer;
        transition: border-color 180ms, background 180ms;
        font-family: inherit;
    }
    .type-chips-toggle:hover {
        border-color: var(--green, #257446);
        background: rgba(37,116,70,.05);
    }
</style>
