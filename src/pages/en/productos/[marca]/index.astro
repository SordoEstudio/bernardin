---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import site from "../../../../data/site.json";
import { cms } from "../../../../lib/cms";
import type { Category } from "../../../../lib/cms/types";

export function getStaticPaths() {
    return site.brands.map((b) => ({
        params: { marca: b.id },
        props: { brand: b },
    }));
}

const { brand } = Astro.props;
const [{ products }, allCategories] = await Promise.all([
    cms.products.list({ locale: "en", category: brand.id, limit: 100 }),
    cms.categories.list(),
]).catch(() => [{ products: [] as import("../../../../lib/cms/types").Product[] }, [] as import("../../../../lib/cms/types").Category[]]);
const uniqueTypes = [
    ...new Set(products.map((p) => p.productType).filter(Boolean)),
] as string[];
const getCat = (slug: string): Category | undefined =>
    allCategories.find((c) => c.slug === slug);
---

<BaseLayout locale="en" title={`${brand.name} | Alfaterra`}>
    <section class="page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/en/productos">Products</a> / {brand.name}
            </div>
            <img
                class="brand-logo-hero"
                src={brand.logo}
                alt={`Logo of ${brand.name}`}
            />
            <h1>{brand.name}</h1>
            <p>{brand.tagEn}</p>
        </div>
    </section>
    <section class="section">
        <div class="container">
            <div class="brand-strip" aria-label="Alfaterra brands">
                {
                    site.brands.map((b) => (
                        <a
                            class:list={{ active: b.id === brand.id }}
                            href={`/en/productos/${b.id}`}
                        >
                            <img src={b.logo} alt={b.name} />
                        </a>
                    ))
                }
            </div>
            <div class="products-column">
                {
                    uniqueTypes.map((typeSlug) => {
                        const cat = getCat(typeSlug);
                        const items = products.filter(
                            (p) => p.productType === typeSlug,
                        );
                        return (
                            <article class="category">
                                <header>
                                    <div>
                                        <span class="eyebrow">{brand.name}</span>
                                        <h2>{cat?.name ?? typeSlug}</h2>
                                    </div>
                                </header>
                                <p>{cat?.description ?? ""}</p>
                                <div class="items">
                                    {items.map((p) => (
                                        <article class="product-card">
                                            <div class="product-media">
                                                <img
                                                    src={p.images?.[0] ?? brand.logo}
                                                    alt={p.locale?.title ?? p.slug}
                                                />
                                            </div>
                                            <h3>
                                                <a
                                                    href={`/en/productos/${brand.id}/${p.slug}`}
                                                >
                                                    {p.locale?.title ?? p.slug}
                                                </a>
                                            </h3>
                                        </article>
                                    ))}
                                </div>
                            </article>
                        );
                    })
                }
            </div>
        </div>
    </section>
    <style>
        .brand-logo-hero {
            width: 210px;
            height: 60px;
            object-fit: contain;
            object-position: left;
            margin: 24px 0 18px;
        }
        .brand-strip {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
            margin: 0 0 42px;
        }
        .brand-strip a {
            background: var(--pale);
            padding: 10px 14px;
            border: 1px solid var(--line);
        }
        .brand-strip a.active {
            border: 2px solid var(--green);
        }
        .brand-strip img {
            width: 130px;
            height: 36px;
            object-fit: contain;
        }
        .products-column {
            max-width: 900px;
        }
        .category {
            padding: 30px 0;
            border-top: 1px solid var(--line);
        }
        .category h2 {
            font-size: clamp(1.7rem, 4vw, 3rem);
            overflow-wrap: anywhere;
        }
        .category p {
            max-width: 640px;
        }
        .items {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }
        .product-card {
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--line);
            box-shadow: var(--shadow);
            transition:
                transform 0.2s,
                box-shadow 0.2s;
        }
        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 44px rgba(37, 116, 70, 0.18);
        }
        .product-media {
            display: grid;
            place-items: center;
            min-height: 170px;
            padding: 28px;
            background: var(--pale);
        }
        .product-media img {
            width: 100%;
            height: 110px;
            object-fit: contain;
        }
        .product-card h3 {
            margin: 0;
            padding: 16px 18px;
            color: var(--blue);
            font-size: 1.05rem;
        }
        @media (max-width: 700px) {
            .items {
                grid-template-columns: 1fr;
            }
        }
    </style>
</BaseLayout>
