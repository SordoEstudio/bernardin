---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import site from "../../../../data/site.json";
import products from "../../../../data/products-en.json";
export function getStaticPaths() {
    return site.brands.map((b) => ({
        params: { marca: b.id },
        props: { brand: b },
    }));
}
const { brand } = Astro.props;
const cats = products[brand.id];
---

<BaseLayout locale="en" title={`${brand.name} | Alfaterra`}
    ><section class="page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/en/productos">Products</a> / {brand.name}
            </div><img
                class="brand-logo-hero"
                src={brand.logo}
                alt={`Logo of ${brand.name}`}
            /><h1>{brand.name}</h1><p>{brand.tagEn}</p>
        </div>
    </section><section class="section">
        <div class="container">
            <div class="brand-strip" aria-label="Alfaterra brands">
                {
                    site.brands.map((b) => (
                        <a
                            class:list={{ active: b.id === brand.id }}
                            href={`/en/productos/${b.id}`}
                        >
                            <img src={b.logo} alt={b.name} />
                        </a>
                    ))
                }
            </div><div class="products-column">
                {
                    cats.map((cat) => (
                        <article class="category">
                            <>
                                <header>
                                    <div>
                                        <>
                                            <span class="eyebrow">
                                                {brand.name}
                                            </span>
                                            <h2>{cat.name}</h2>
                                        </>
                                    </div>
                                </header>
                                <p>{cat.description}</p>
                                <div class="items">
                                    {cat.items.map((item) => {
                                        const product =
                                            typeof item === "string"
                                                ? { name: item }
                                                : item;
                                        return (
                                            <article class="product-card">
                                                <div class="product-media">
                                                    {product.image ? (
                                                        <img
                                                            src={product.image}
                                                            alt={product.name}
                                                        />
                                                    ) : (
                                                        <img
                                                            src={brand.logo}
                                                            alt={`Logo of ${brand.name}`}
                                                        />
                                                    )}
                                                </div>
                                                <h3>
                                                    <a
                                                        href={`/en/productos/${brand.id}/${encodeURIComponent(
                                                            product.name
                                                                .toLowerCase()
                                                                .replace(
                                                                    /[^a-z0-9]+/g,
                                                                    "-",
                                                                )
                                                                .replace(
                                                                    /^-|-$/g,
                                                                    "",
                                                                ),
                                                        )}`}
                                                    >
                                                        {product.name}
                                                    </a>
                                                </h3>
                                            </article>
                                        );
                                    })}
                                </div>
                            </>
                        </article>
                    ))
                }
            </div>
        </div>
    </section><style>
        .brand-logo-hero {
            width: 210px;
            height: 60px;
            object-fit: contain;
            object-position: left;
            margin: 24px 0 18px;
        }
        .brand-strip {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
            margin: 0 0 42px;
        }
        .brand-strip a {
            background: var(--pale);
            padding: 10px 14px;
            border: 1px solid var(--line);
        }
        .brand-strip a.active {
            border: 2px solid var(--green);
        }
        .brand-strip img {
            width: 130px;
            height: 36px;
            object-fit: contain;
        }
        .products-column {
            max-width: 900px;
        }
        .category {
            padding: 30px 0;
            border-top: 1px solid var(--line);
        }
        .category h2 {
            font-size: clamp(1.7rem, 4vw, 3rem);
            overflow-wrap: anywhere;
        }
        .category p {
            max-width: 640px;
        }
        .items {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }
        .product-card {
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--line);
            box-shadow: var(--shadow);
            transition:
                transform 0.2s,
                box-shadow 0.2s;
        }
        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 44px rgba(37, 116, 70, 0.18);
        }
        .product-media {
            display: grid;
            place-items: center;
            min-height: 170px;
            padding: 28px;
            background: var(--pale);
        }
        .product-media img {
            width: 100%;
            height: 110px;
            object-fit: contain;
        }
        .product-card h3 {
            margin: 0;
            padding: 16px 18px;
            color: var(--blue);
            font-size: 1.05rem;
        }
        @media (max-width: 700px) {
            .items {
                grid-template-columns: 1fr;
            }
        }
    </style>
</BaseLayout>
