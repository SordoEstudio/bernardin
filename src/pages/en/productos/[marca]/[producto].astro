---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import site from "../../../../data/site.json";
import { cms } from "../../../../lib/cms";
import type { Product, Category, CMSComponent } from "../../../../lib/cms/types";
import { BRAND_CATEGORY_ID, getTypeNamesForProduct } from "../../../../lib/products-utils";
import { marked } from "marked";

export async function getStaticPaths() {
    try {
        const [brandsData, allCategories, { components: prodComponents }] = await Promise.all([
            Promise.all(
                site.brands
                    .filter((b) => BRAND_CATEGORY_ID[b.id])
                    .map((b) =>
                        cms.products
                            .list({ locale: "en", category: BRAND_CATEGORY_ID[b.id], limit: 500 })
                            .then(({ products }) => products.map((p) => ({ brandId: b.id, product: p }))),
                    ),
            ).then((r) => r.flat()),
            cms.categories.list().catch(() => [] as Category[]),
            cms.components.list({ page_filter: "Productos", locale: "en" }).catch(() => ({ components: [] as CMSComponent[] })),
        ]);
        return brandsData.map(({ brandId, product }) => ({
            params: { marca: brandId, producto: product.slug },
            props: { product, brandId, allCategories, prodComponents },
        }));
    } catch {
        return [];
    }
}

const { product, brandId, allCategories, prodComponents } = Astro.props as {
    product: Product;
    brandId: string;
    allCategories: Category[];
    prodComponents: CMSComponent[];
};
const brand = site.brands.find((b) => b.id === brandId)!;

interface ProductoDetalleData { txt_h2?: string; txt_cta_label?: string; }
const productoDetalle = cms.components.getByType<ProductoDetalleData>(prodComponents, "producto_detalle");
const typeName = getTypeNamesForProduct(product)[0];
const typeCategory = typeName ? allCategories.find((c) => c.name === typeName) : undefined;
const images = product.images?.length ? product.images : [brand.logo];
const productName = product.locale?.title ?? product.slug;
const productDescRaw = product.locale?.description ?? typeCategory?.description ?? "";
const productDesc = marked.parse(productDescRaw) as string;
---

<BaseLayout locale="en" title={`${productName} | ${brand.name} | Bernardin`}>
    <section class="page-hero">
        <div class="container">
            <div class="breadcrumbs">
                <a href="/en/productos">Products</a> / <a
                    href={`/en/productos/${brand.id}`}>{brand.name}</a
                > / {productName}
            </div><span class="eyebrow">{brand.name}</span><h1>
                {productName}
            </h1><div class="prose" set:html={productDesc} />
        </div>
    </section>
    <section class="section">
        <div class="container product-detail">
            <div class="product-gallery">
                <div class="gallery-main">
                    <img src={images[0]} alt={productName} />
                </div>{
                    images.length > 1 && (
                        <div class="gallery-thumbs">
                            {images.map((image, index) => (
                                <a href={`#media-${index}`}>
                                    <img
                                        id={`media-${index}`}
                                        src={image}
                                        alt={`${productName}, image ${index + 1}`}
                                    />
                                </a>
                            ))}
                        </div>
                    )
                }
            </div><div class="product-copy">
                <span class="eyebrow">{typeName ?? ""}</span><h2>
                    {productoDetalle?.txt_h2}
                </h2><div class="prose" set:html={productDesc} /><a
                    class="btn"
                    href={`/en/contacto?producto=${encodeURIComponent(productName)}`}
                    >{productoDetalle?.txt_cta_label} <span>→</span></a
                >
            </div>
        </div>
    </section>
</BaseLayout>
<style>
    .product-detail {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
        gap: clamp(34px, 7vw, 90px);
        align-items: center;
    }
    .gallery-main {
        display: grid;
        place-items: center;
        min-height: 420px;
        padding: 48px;
        border: 1px solid var(--line);
        border-radius: 22px;
        background:
            radial-gradient(
                circle at 50% 45%,
                rgba(64, 181, 83, 0.12),
                transparent 65%
            ),
            var(--pale);
        box-shadow: var(--shadow);
    }
    .gallery-main img {
        width: 100%;
        height: 330px;
        object-fit: contain;
    }
    .gallery-thumbs {
        display: flex;
        gap: 12px;
        margin-top: 16px;
    }
    .gallery-thumbs a {
        padding: 6px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #fff;
    }
    .gallery-thumbs img {
        width: 74px;
        height: 58px;
        object-fit: cover;
    }
    .product-copy h2 {
        margin: 12px 0 20px;
    }
    .prose {
        max-width: 520px;
        margin-bottom: 30px;
        color: #5b675e;
        line-height: 1.7;
    }
    .prose :global(p) { margin: 0 0 12px; }
    .prose :global(ul) { padding-left: 1.2em; margin: 0 0 12px; }
    .prose :global(li) { margin-bottom: 4px; }
    .prose :global(strong) { color: var(--green, #257446); font-weight: 700; }
    @media (max-width: 760px) {
        .product-detail {
            grid-template-columns: 1fr;
        }
        .gallery-main {
            min-height: 280px;
            padding: 28px;
        }
        .gallery-main img {
            height: 240px;
        }
    }
</style>
