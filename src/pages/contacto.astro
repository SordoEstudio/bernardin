---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import { cms } from '../lib/cms';

interface CMSContactItem { icon_contacto?: string; txt_label: string; link_destino: string; txt_valor?: string; }
interface ContactoInfoData { lista_contacto?: CMSContactItem[]; }

const { components } = await cms.components.list({ page_filter: 'Contacto', locale: 'es' }).catch(() => ({ components: [] }));
const contactoInfo = cms.components.getByType<ContactoInfoData>(components, 'contacto_info');
const contactLinks = contactoInfo?.lista_contacto ?? [
  { txt_label: 'WhatsApp', link_destino: `https://wa.me/${site.contact.whatsapp}`, txt_valor: '+54 9 3492 597277' },
  { txt_label: 'Email', link_destino: `mailto:${site.contact.email}`, txt_valor: site.contact.email },
];
---
<BaseLayout locale="es" title="Contacto | Alfaterra"><section class="page-hero"><div class="container"><div class="breadcrumbs">Inicio / Contacto</div><h1>Hablemos de tu próximo desafío.</h1></div></section><section class="section"><div class="container contact-grid"><div><span class="eyebrow">Contacto directo</span><h2>Estamos para ayudarte.</h2><p>Contanos qué estás buscando y nuestro equipo se pondrá en contacto.</p>{contactLinks.map((c) => <div class="contact-card"><strong>{c.txt_label}</strong><a href={c.link_destino}>{c.txt_valor ?? c.link_destino} →</a></div>)}</div><form id="contact-form" class="form contact-card"><div class="form-field"><label for="nombre">Nombre</label><input id="nombre" required name="nombre" placeholder="Tu nombre" /></div><div class="form-field"><label for="email">Email</label><input id="email" required type="email" name="email" placeholder="tu@email.com" /></div><div class="form-field"><label for="mensaje">Mensaje</label><textarea id="mensaje" required name="mensaje" placeholder="¿En qué podemos ayudarte?"></textarea></div><button class="btn" type="submit">Enviar consulta →</button></form></div></section><style>
.contact-card{width:100%;max-width:820px;margin-inline:auto;padding:clamp(24px,4vw,42px)}.form.contact-card{max-width:820px}.contact-card label{display:block;margin:0 0 8px;font:700 .78rem var(--display);letter-spacing:.08em;text-transform:uppercase;color:var(--green)}.contact-card input,.contact-card textarea{width:100%;border:1px solid var(--line);border-radius:3px;padding:13px 15px;background:#fff;color:var(--ink);margin-bottom:18px}.contact-card textarea{min-height:150px;resize:vertical}.contact-card .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 20px}.contact-card .form-grid .full{grid-column:1/-1}@media(max-width:640px){.contact-card .form-grid{grid-template-columns:1fr}.contact-card .form-grid .full{grid-column:auto}}
</style>
<script is:inline define:vars={{ endpoint: `${import.meta.env.PUBLIC_CMS_API}/forms/contacto/submit` }}>
  document.getElementById('contact-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = e.currentTarget.querySelector('[type="submit"]');
    btn.disabled = true;
    const body = Object.fromEntries(new FormData(e.currentTarget));
    try {
      const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const json = await res.json();
      if (json.success) {
        e.currentTarget.innerHTML = `<p style="color:var(--green);padding:24px">${json.data?.message ?? '¡Mensaje enviado!'}</p>`;
      } else { btn.disabled = false; alert('Error al enviar. Intente nuevamente.'); }
    } catch { btn.disabled = false; alert('Error de conexión. Intente nuevamente.'); }
  });
</script>
</BaseLayout>
