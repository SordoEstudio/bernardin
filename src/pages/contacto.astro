---
import BaseLayout from '../layouts/BaseLayout.astro'; import site from '../data/site.json'
---
<BaseLayout locale="es" title="Contacto | Alfaterra"><section class="page-hero"><div class="container"><div class="breadcrumbs">Inicio / Contacto</div><h1>Hablemos de tu próximo desafío.</h1></div></section><section class="section"><div class="container contact-grid"><div><span class="eyebrow">Contacto directo</span><h2>Estamos para ayudarte.</h2><p>Contanos qué estás buscando y nuestro equipo se pondrá en contacto.</p><div class="contact-card"><strong>WhatsApp</strong><a href={`https://wa.me/${site.contact.whatsapp}`}>+54 9 3492 597277 →</a></div><div class="contact-card"><strong>Email</strong><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></div></div><form class="form contact-card"><div class="form-field"><label for="name">Nombre</label><input id="name" required name="name" placeholder="Tu nombre" /></div><div class="form-field"><label for="email">Email</label><input id="email" required type="email" name="email" placeholder="tu@email.com" /></div><div class="form-field"><label for="message">Mensaje</label><textarea id="message" required name="message" placeholder="¿En qué podemos ayudarte?"></textarea></div><button class="btn" type="submit">Enviar consulta →</button></form></div></section><style>
.contact-card{width:100%;max-width:820px;margin-inline:auto;padding:clamp(24px,4vw,42px)}.form.contact-card{max-width:820px}.contact-card label{display:block;margin:0 0 8px;font:700 .78rem var(--display);letter-spacing:.08em;text-transform:uppercase;color:var(--green)}.contact-card input,.contact-card textarea{width:100%;border:1px solid var(--line);border-radius:3px;padding:13px 15px;background:#fff;color:var(--ink);margin-bottom:18px}.contact-card textarea{min-height:150px;resize:vertical}.contact-card .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 20px}.contact-card .form-grid .full{grid-column:1/-1}@media(max-width:640px){.contact-card .form-grid{grid-template-columns:1fr}.contact-card .form-grid .full{grid-column:auto}}
</style>
</BaseLayout>
