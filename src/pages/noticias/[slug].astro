---
import BaseLayout from '../../layouts/BaseLayout.astro'; import news from '../../data/news.json'
export function getStaticPaths(){return news.articles.map(article=>({params:{slug:article.slug},props:{article}}))}; const {article}=Astro.props
---
<BaseLayout title={`${article.title.es} | Alfaterra`} locale="es"><section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/noticias">Noticias</a> / {article.date}</div><span class="eyebrow">Alfaterra al día</span><h1>{article.title.es}</h1><p>{article.excerpt.es}</p></div></section><article class="section article-page"><div class="container article-layout"><div class="article-cover"><strong>Alfaterra</strong></div><div class="article-copy"><time>{article.date}</time>{article.body.es.map(p=><p>{p}</p>)}{article.media?.length>0&&<div class="media-carousel"><div class="media-track">{article.media.map((media,index)=>media.type==='youtube'?<div class="media-slide" data-slide><div class="video-wrap"><iframe src={media.src} title={media.title} loading="lazy" allowfullscreen></iframe></div></div>:<div class="media-slide" data-slide><img src={media.src} alt={media.alt.es}/></div>)}</div>{article.media.length>1&&<div class="carousel-controls"><button type="button" data-prev aria-label="Contenido anterior">←</button><span data-count>1 / {article.media.length}</span><button type="button" data-next aria-label="Contenido siguiente">→</button></div>}</div>}<a class="btn" href="/noticias">Volver a noticias</a></div></div></article><script>const slides=[...document.querySelectorAll('[data-slide]')],count=document.querySelector('[data-count]');let active=0;function show(i){active=(i+slides.length)%slides.length;slides.forEach((s,n)=>s.hidden=n!==active);if(count)count.textContent=`${active+1} / ${slides.length}`}document.querySelector('[data-prev]')?.addEventListener('click',()=>show(active-1));document.querySelector('[data-next]')?.addEventListener('click',()=>show(active+1));show(0)</script><style>.article-layout{display:grid;grid-template-columns:minmax(280px,.8fr) 1.2fr;gap:clamp(36px,7vw,96px)}.article-cover{min-height:360px;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,var(--green),var(--blue));font:700 clamp(3rem,7vw,6rem) var(--display)}.article-copy{max-width:680px}.article-copy time{color:var(--blue);font-weight:700}.article-copy p{font-size:1.12rem}.media-carousel{margin:32px 0}.media-slide img{width:100%;height:auto}.video-wrap{aspect-ratio:16/9}.video-wrap iframe{width:100%;height:100%;border:0}.carousel-controls{display:flex;justify-content:space-between;align-items:center;margin-top:12px}.carousel-controls button{border:1px solid var(--line);background:white;color:var(--blue);padding:8px 14px}@media(max-width:760px){.article-layout{grid-template-columns:1fr}.article-cover{min-height:220px}}</style></BaseLayout>
