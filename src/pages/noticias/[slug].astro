---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cms } from '../../lib/cms';
import type { NewsItem } from '../../lib/cms/types';

interface NoticiasHeaderData { txt_eyebrow?: string; txt_volver?: string; }

export async function getStaticPaths() {
    const { items } = await cms.news.list({ limit: 100 });
    return items.map((n) => ({ params: { slug: n.slug }, props: { article: n } }));
}

const { article } = Astro.props as { article: NewsItem };
const { components } = await cms.components.list({ page_filter: 'Noticias', locale: 'es' }).catch(() => ({ components: [] }));
const noticiasHeader = cms.components.getByType<NoticiasHeaderData>(components, 'noticias_header');
const fmtDate = (item: NewsItem) =>
    new Date(item.publishedAt ?? item.createdAt).toLocaleDateString('es-AR', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
    });
---
<BaseLayout title={`${article.title} | Bernardin`} locale="es">
    <section class="page-hero">
        <div class="container">
            <div class="breadcrumbs"><a href="/noticias">Noticias</a> / {fmtDate(article)}</div>
            <span class="eyebrow">{noticiasHeader?.txt_eyebrow}</span>
            <h1>{article.title}</h1>
            <p>{article.summary ?? ''}</p>
        </div>
    </section>
    <article class="section article-page">
        <div class="container article-layout">
            <div class="article-cover"><strong>Bernardin</strong></div>
            <div class="article-copy">
                <time>{fmtDate(article)}</time>
                <div set:html={article.content ?? ''} />
                {article.gallery && article.gallery.length > 0 && (
                    <div class="media-carousel">
                        <div class="media-track">
                            {article.gallery.map((_img) => (
                                <div class="media-slide" data-slide>
                                    <img src={_img.url} alt={_img.alt ?? ''} />
                                </div>
                            ))}
                        </div>
                        {article.gallery.length > 1 && (
                            <div class="carousel-controls">
                                <button type="button" data-prev aria-label="Contenido anterior">←</button>
                                <span data-count>1 / {article.gallery.length}</span>
                                <button type="button" data-next aria-label="Contenido siguiente">→</button>
                            </div>
                        )}
                    </div>
                )}
                <a class="btn" href="/noticias">{noticiasHeader?.txt_volver}</a>
            </div>
        </div>
    </article>
</BaseLayout>
<script>
    const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')];
    const count = document.querySelector('[data-count]');
    let active = 0;
    function show(i: number) {
        active = (i + slides.length) % slides.length;
        slides.forEach((s, n) => (s.hidden = n !== active));
        if (count) count.textContent = `${active + 1} / ${slides.length}`;
    }
    document.querySelector('[data-prev]')?.addEventListener('click', () => show(active - 1));
    document.querySelector('[data-next]')?.addEventListener('click', () => show(active + 1));
    show(0);
</script>
<style>
    .article-layout { display: grid; grid-template-columns: minmax(280px, .8fr) 1.2fr; gap: clamp(36px, 7vw, 96px) }
    .article-cover { min-height: 360px; display: grid; place-items: center; color: #fff; background: linear-gradient(135deg, var(--green), var(--blue)); font: 700 clamp(3rem, 7vw, 6rem) var(--display) }
    .article-copy { max-width: 680px }
    .article-copy time { color: var(--blue); font-weight: 700 }
    .article-copy p { font-size: 1.12rem }
    .media-carousel { margin: 32px 0 }
    .media-slide img { width: 100%; height: auto }
    .carousel-controls { display: flex; justify-content: space-between; align-items: center; margin-top: 12px }
    .carousel-controls button { border: 1px solid var(--line); background: white; color: var(--blue); padding: 8px 14px }
    @media (max-width: 760px) { .article-layout { grid-template-columns: 1fr } .article-cover { min-height: 220px } }
</style>
