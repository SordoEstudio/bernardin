---
import BaseLayout from "../../layouts/BaseLayout.astro";
import news from "../../data/news.json";
const locale = "es";
---

<BaseLayout title="Noticias | Alfaterra" locale={locale}>
    <section class="page-hero">
        <div class="container">
            <span class="eyebrow">Alfaterra al día</span><h1>Noticias</h1><p>
                Ideas, novedades y todo lo que pasa cerca del campo.
            </p>
        </div>
    </section>
    <section class="section">
        <div class="container">
            <div class="news-grid" id="news-grid">
                {
                    [...news.articles]
                        .sort((a, b) => {
                            const parse = (date: string): number => {
                                const [day, month, year] = date
                                    .split(".")
                                    .map(Number);
                                return new Date(year, month - 1, day).getTime();
                            };
                            return parse(b.date) - parse(a.date);
                        })
                        .map((article, index) => (
                            <article
                                class:list={[
                                    "news-card",
                                    { featured: index === 0 },
                                ]}
                                data-news-card
                                data-featured={index === 0 ? "true" : "false"}
                            >
                                <>
                                    <div class="news-image">
                                        <>
                                            <span>Alfaterra al día</span>
                                            <strong>
                                                {String(index + 1).padStart(
                                                    2,
                                                    "0",
                                                )}
                                            </strong>
                                        </>
                                    </div>
                                    <div class="news-content">
                                        <>
                                            <time>{article.date}</time>
                                            <h2>{article.title[locale]}</h2>
                                            <p>{article.excerpt[locale]}</p>
                                            <a
                                                href={`/noticias/${article.slug}`}
                                            >
                                                Leer noticia <span>→</span>
                                            </a>
                                        </>
                                    </div>
                                </>
                            </article>
                        ))
                }
            </div><nav
                class="pagination"
                aria-label="Paginación de noticias"
                data-pagination
            >
            </nav>
        </div>
    </section>
</BaseLayout>
<script>
    const cards = [...document.querySelectorAll("[data-news-card]")],
        pagination = document.querySelector("[data-pagination]"),
        perPage = 6,
        featured = cards.find((card) => card.dataset.featured === "true"),
        regular = cards.filter((card) => card.dataset.featured !== "true"),
        pages = Math.max(1, Math.ceil(regular.length / perPage)),
        params = new URLSearchParams(location.search);
    let current = Math.min(
        Math.max(Number(params.get("pagina")) || 1, 1),
        pages,
    );
    if (featured) featured.hidden = false;
    regular.forEach(
        (card, i) =>
            (card.hidden =
                i < (current - 1) * perPage || i >= current * perPage),
    );
    if (pagination && pages > 1)
        pagination.innerHTML = Array.from(
            { length: pages },
            (_, i) =>
                `<a class="${i + 1 === current ? "is-current" : ""}" href="?pagina=${i + 1}" aria-current="${i + 1 === current ? "page" : "false"}">${i + 1}</a>`,
        ).join("");
</script>
<style>
    .news-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 28px;
    }
    .news-card[hidden] {
        display: none;
    }
    .news-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--line);
        box-shadow: var(--shadow);
    }
    .news-card.featured {
        grid-column: span 2;
        display: grid;
        grid-template-columns: 1.05fr 1fr;
    }
    .news-image {
        min-height: 220px;
        padding: 22px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        color: #fff;
        background: linear-gradient(135deg, var(--green), var(--blue));
    }
    .news-card.featured .news-image {
        min-height: 360px;
    }
    .news-image strong {
        font: 700 clamp(5rem, 12vw, 10rem)/0.8 var(--display);
        opacity: 0.9;
    }
    .news-content {
        padding: 28px 30px;
    }
    .news-content time {
        color: var(--blue);
        font-weight: 700;
    }
    .news-content h2 {
        margin: 14px 0 12px;
        font-size: clamp(1.5rem, 3vw, 2.25rem);
    }
    .news-content p {
        color: #566b60;
    }
    .news-content a {
        color: var(--blue);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .pagination {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 44px;
    }
    .pagination a {
        min-width: 46px;
        padding: 11px 14px;
        text-align: center;
        border: 1px solid var(--line);
        border-radius: 4px;
        color: var(--blue);
        background: #fff;
        font-weight: 700;
        transition: 0.2s;
    }
    .pagination a:hover {
        border-color: var(--green);
        background: var(--pale);
    }
    .pagination a[aria-current="page"] {
        background: var(--green);
        border: 2px solid var(--green);
        color: #fff;
        box-shadow:
            0 0 0 4px rgba(37, 116, 70, 0.14),
            0 5px 14px rgba(37, 116, 70, 0.22);
        transform: translateY(-2px);
    }
    @media (max-width: 700px) {
        .news-grid {
            grid-template-columns: 1fr;
        }
        .news-card.featured {
            grid-column: auto;
            display: block;
        }
    }
</style>
