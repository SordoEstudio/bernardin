---
import BaseLayout from "../layouts/BaseLayout.astro";
import { cms } from "../lib/cms";

interface MilestonesData { lista_milestones?: { txt_year: string; txt_descripcion: string }[]; }
interface ValoresData { lista_valores?: { txt_titulo: string; txt_descripcion: string }[]; }

const { components } = await cms.components.list({ page_filter: "Empresa", locale: "es" }).catch(() => ({ components: [] }));
const milestonesData = cms.components.getByType<MilestonesData>(components, "milestones");
const valoresData = cms.components.getByType<ValoresData>(components, "valores");

const milestones = milestonesData?.lista_milestones ?? [
  { txt_year: "1924", txt_descripcion: "Nace una historia ligada al campo argentino." },
  { txt_year: "1978", txt_descripcion: "El conocimiento técnico se convierte en acompañamiento cercano." },
  { txt_year: "2008", txt_descripcion: "Alfaterra amplía su red y suma nuevas marcas internacionales." },
  { txt_year: "Hoy",  txt_descripcion: "Seguimos conectando tecnología, personas y territorio." },
];
const valores = valoresData?.lista_valores ?? [
  { txt_titulo: "Misión",  txt_descripcion: "Acercar tecnología confiable y acompañamiento experto a cada productor." },
  { txt_titulo: "Visión",  txt_descripcion: "Ser el socio estratégico de referencia para una agricultura más eficiente." },
  { txt_titulo: "Valores", txt_descripcion: "Construimos vínculos con compromiso, conocimiento y transparencia." },
];
---

<BaseLayout locale="es" title="Empresa | Alfaterra"
  ><section class="page-hero">
    <div class="container">
      <div class="breadcrumbs">Inicio / Empresa</div><h1>
        Una historia de campo, innovación y confianza.
      </h1>
    </div>
  </section><section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">Quiénes somos</span><h2>
          Conocemos el campo porque somos parte de él.
        </h2>
      </div><div>
        <p class="quote">
          “La mejor tecnología es la que se convierte en resultados concretos.”
        </p><p>
          Alfaterra conecta a productores argentinos con maquinaria agrícola de
          primer nivel. Nuestro equipo combina experiencia comercial,
          conocimiento técnico y una mirada de largo plazo.
        </p>
      </div>
    </div>
  </section><section class="section soft">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Nuestra historia</span><h2>
            Un camino que sigue creciendo
          </h2>
        </div>
      </div><div class="timeline">
        {
          milestones.map((m) => (
            <div class="timeline-item">
              <>
                <strong>{m.txt_year}</strong>
                <p>{m.txt_descripcion}</p>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section><section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Nuestros principios</span><h2>
            Lo que nos mueve
          </h2>
        </div>
      </div><div class="brand-grid">
        {valores.map((v) => (
          <div class="brand-card">
            <h3>{v.txt_titulo}</h3><p>{v.txt_descripcion}</p>
          </div>
        ))}
      </div>
    </div>
  </section></BaseLayout
>
<style>
  .timeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 2px solid var(--green);
    gap: 24px;
  }
  .timeline-item {
    position: relative;
    padding-top: 28px;
  }
  .timeline-item:before {
    content: "";
    position: absolute;
    top: -9px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--green);
    border: 3px solid var(--pale);
  }
  .timeline-item strong {
    font: 700 2rem var(--display);
    color: var(--blue);
  }
  .timeline-item p {
    max-width: 210px;
  }
  @media (max-width: 700px) {
    .timeline {
      grid-template-columns: 1fr;
      border-top: 0;
      border-left: 2px solid var(--green);
      padding-left: 24px;
    }
    .timeline-item {
      padding-top: 0;
      padding-bottom: 22px;
    }
    .timeline-item:before {
      left: -33px;
      top: 4px;
    }
  }
</style>
